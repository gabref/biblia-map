{"22627":[{"footnoteId":7043,"paragraphs":[{"pid":38,"text":"Meaning “Servant of Jehovah.”"}]}],"22630":[{"footnoteId":7044,"paragraphs":[{"pid":39,"text":"Or possibly, “you fly high.”"}]}],"22631":[{"footnoteId":7045,"paragraphs":[{"pid":40,"text":"Or possibly, “How much would they destroy?”"}]}],"22633":[{"footnoteId":7046,"paragraphs":[{"pid":41,"text":"Or “those in covenant with you.”"}]}],"22646":[{"footnoteId":7047,"paragraphs":[{"pid":42,"text":"Or “fortification.”"}]}]}