{"22648":[{"footnoteId":7048,"paragraphs":[{"pid":41,"text":"Meaning “Dove.”"}]}],"22652":[{"footnoteId":7049,"paragraphs":[{"pid":42,"text":"Or “decked vessel.”"}]}],"22656":[{"footnoteId":7050,"paragraphs":[{"pid":43,"text":"Or “worship.”"}]}],"22660":[{"footnoteId":7051,"paragraphs":[{"pid":44,"text":"Or “tried to work their way through.”"}]}],"22661":[{"footnoteId":7052,"paragraphs":[{"pid":45,"text":"Or “because of the soul of this man!”"}]}],"22666":[{"footnoteId":7053,"paragraphs":[{"pid":46,"text":"Lit., “belly.”"}]},{"footnoteId":7054,"paragraphs":[{"pid":47,"text":"Or “Sheol,” that is, the common grave of mankind. See Glossary."}]}],"22669":[{"footnoteId":7055,"paragraphs":[{"pid":48,"text":"Or “Waters encompassed me to the soul.”"}]}],"22671":[{"footnoteId":7056,"paragraphs":[{"pid":49,"text":"Or “soul.”"}]}],"22672":[{"footnoteId":7057,"paragraphs":[{"pid":50,"text":"Or possibly, “their loyalty.”"}]}],"22677":[{"footnoteId":7058,"paragraphs":[{"pid":51,"text":"Lit., “a city great to God.”"}]}],"22683":[{"footnoteId":7059,"paragraphs":[{"pid":52,"text":"Or “feel regret over.”"}]}],"22684":[{"footnoteId":7060,"paragraphs":[{"pid":53,"text":"Or “felt regret over.”"}]}],"22686":[{"footnoteId":7061,"paragraphs":[{"pid":54,"text":"Or “gracious.”"}]}],"22687":[{"footnoteId":7062,"paragraphs":[{"pid":55,"text":"Or “soul.”"}]}],"22690":[{"footnoteId":7063,"paragraphs":[{"pid":56,"text":"Or possibly, “castor-oil plant.”"}]}],"22692":[{"footnoteId":7064,"paragraphs":[{"pid":57,"text":"Or “that his soul might die.”"}]}],"22695":[{"footnoteId":7065,"paragraphs":[{"pid":58,"text":"Or “know their right hand from their left.”"}]}]}