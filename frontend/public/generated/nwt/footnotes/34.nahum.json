{"22801":[{"footnoteId":7118,"paragraphs":[{"pid":103,"text":"Meaning “Comforter.”"}]}],"22807":[{"footnoteId":7119,"paragraphs":[{"pid":104,"text":"Or “takes care of.” Lit., “knows.”"}]}],"22808":[{"footnoteId":7120,"paragraphs":[{"pid":105,"text":"That is, Nineveh’s."}]}],"22810":[{"footnoteId":7121,"paragraphs":[{"pid":106,"text":"Or “wheat beer.”"}]}],"22812":[{"footnoteId":7122,"paragraphs":[{"pid":107,"text":"Or possibly, “and he will pass through.”"}]},{"footnoteId":7123,"paragraphs":[{"pid":108,"text":"That is, Judah."}]}],"22814":[{"footnoteId":7124,"paragraphs":[{"pid":109,"text":"That is, Assyria."}]},{"footnoteId":7125,"paragraphs":[{"pid":110,"text":"Or “molten statues.”"}]},{"footnoteId":7126,"paragraphs":[{"pid":111,"text":"Or “temple.”"}]}],"22816":[{"footnoteId":7127,"paragraphs":[{"pid":112,"text":"That is, Nineveh."}]},{"footnoteId":7128,"paragraphs":[{"pid":113,"text":"Lit., “Strengthen the hips.”"}]}],"22821":[{"footnoteId":7129,"paragraphs":[{"pid":114,"text":"Or “will collapse.”"}]}],"22822":[{"footnoteId":7130,"paragraphs":[{"pid":115,"text":"Or “fixed.”"}]},{"footnoteId":7131,"paragraphs":[{"pid":116,"text":"Lit., “hearts.”"}]}],"22826":[{"footnoteId":7132,"paragraphs":[{"pid":117,"text":"Or “maned young lions.”"}]}],"22828":[{"footnoteId":7133,"paragraphs":[{"pid":118,"text":"Or “maned young lions.”"}]}],"22833":[{"footnoteId":7134,"paragraphs":[{"pid":119,"text":"That is, Nineveh."}]}],"22836":[{"footnoteId":7135,"paragraphs":[{"pid":120,"text":"That is, Thebes."}]}],"22838":[{"footnoteId":7136,"paragraphs":[{"pid":121,"text":"Lit., “at the head of all streets.”"}]}]}