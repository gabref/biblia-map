e”."}]}],"3558":[{"footnoteId":912,"paragraphs":[{"pid":511,"text":"O “osserverà il Sabato”."}]}],"3565":[{"footnoteId":913,"paragraphs":[{"pid":512,"text":"O “ostinato”."}]}],"3567":[{"footnoteId":914,"paragraphs":[{"pid":513,"text":"O “e le loro anime avranno disprezzato”."}]}],"3572":[{"footnoteId":915,"paragraphs":[{"pid":514,"text":"O “anima”."}]}],"3573":[{"footnoteId":916,"paragraphs":[{"pid":515,"text":"Un siclo corrispondeva a 11,4 g. Vedi App. B14."}]},{"footnoteId":917,"paragraphs":[{"pid":516,"text":"O “in base al siclo santo”."}]}],"3586":[{"footnoteId":918,"paragraphs":[{"pid":517,"text":"Un hòmer corrispondeva a 220 l. Vedi App. B14."}]}],"3595":[{"footnoteId":919,"paragraphs":[{"pid":518,"text":"Una ghera corrispondeva a 0,57 g. Vedi App. B14."}]}],"3598":[{"footnoteId":920,"paragraphs":[{"pid":519,"text":"O “voti alla distruzione”."}]}],"3599":[{"footnoteId":921,"paragraphs":[{"pid":520,"text":"O “votata”."}]}]}