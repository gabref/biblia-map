ire”."}]},{"footnoteId":5362,"paragraphs":[{"pid":210,"text":"O forse “sul tuo letto”."}]},{"footnoteId":5363,"paragraphs":[{"pid":211,"text":"Lett. “volatile dei cieli”."}]}],"17630":[{"footnoteId":5364,"paragraphs":[{"pid":212,"text":"O “manda”."}]}],"17631":[{"footnoteId":5365,"paragraphs":[{"pid":213,"text":"O “calamità”."}]}],"17634":[{"footnoteId":5366,"paragraphs":[{"pid":214,"text":"Lett. “ossa nel grembo”."}]}],"17638":[{"footnoteId":5367,"paragraphs":[{"pid":215,"text":"O “ti chiamerà in giudizio”."}]}],"17639":[{"footnoteId":5368,"paragraphs":[{"pid":216,"text":"Lett. “carne”."}]},{"footnoteId":5369,"paragraphs":[{"pid":217,"text":"O “sono fugaci”."}]}],"17640":[{"footnoteId":5370,"paragraphs":[{"pid":218,"text":"O “calamitosi”."}]}],"17641":[{"footnoteId":5371,"paragraphs":[{"pid":219,"text":"O forse “con”."}]}],"17646":[{"footnoteId":5372,"paragraphs":[{"pid":220,"text":"O “forza vitale”."}]}],"17647":[{"footnoteId":5373,"paragraphs":[{"pid":221,"text":"O “futilità”."}]}],"17648":[{"footnoteId":5374,"paragraphs":[{"pid":222,"text":"O “comporre”."}]}],"17650":[{"footnoteId":5375,"paragraphs":[{"pid":223,"text":"Vedi Glossario."}]}]}