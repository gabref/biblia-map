":7165,"paragraphs":[{"pid":371,"text":"O “immoralità sessuale”, “promiscuità sessuale”."}]},{"footnoteId":7166,"paragraphs":[{"pid":372,"text":"O “immoralità sessuale”, “promiscuità sessuale”."}]}],"22262":[{"footnoteId":7167,"paragraphs":[{"pid":373,"text":"O “praticano l’immoralità sessuale”."}]}],"22263":[{"footnoteId":7168,"paragraphs":[{"pid":374,"text":"O “immoralità sessuale”, “promiscuità sessuale”."}]}],"22264":[{"footnoteId":7169,"paragraphs":[{"pid":375,"text":"O “immoralità sessuale”, “promiscuità sessuale”."}]}],"22265":[{"footnoteId":7170,"paragraphs":[{"pid":376,"text":"Lett. “luogo spazioso”."}]}],"22267":[{"footnoteId":7171,"paragraphs":[{"pid":377,"text":"O “birra di frumento”."}]},{"footnoteId":7172,"paragraphs":[{"pid":378,"text":"O “si dà alla prostituzione”, “ha rapporti sessuali con molte persone”."}]},{"footnoteId":7173,"paragraphs":[{"pid":379,"text":"Lett. “scudi”."}]}],"22270":[{"footnoteId":7174,"paragraphs":[{"pid":380,"text":"O “i ribelli”."}]},{"footnoteId":7175,"paragraphs":[{"pid":381,"text":"O “disciplinerò”."}]}],"22271":[{"footnoteId":7176,"paragraphs":[{"pid":382,"text":"O “ti sei dato alla prostituzione”, “hai avuto rapporti sessuali con molte persone”."}]}],"22272":[{"footnoteId":7177,"paragraphs":[{"pid":383,"text":"O “immoralità sessuale”, “promiscuità sessuale”."}]}],"22273":[{"footnoteId":7178,"paragraphs":[{"pid":384,"text":"Lett. “la sua faccia”."}]}],"22275":[{"footnoteId":7179,"paragraphs":[{"pid":385,"text":"Forse nati da mogli straniere e quindi lontani da Dio."}]}],"22282":[{"footnoteId":7180,"paragraphs":[{"pid":386,"text":"O “giovane leone con la criniera”."}]}],"22283":[{"footnoteId":7181,"paragraphs":[{"pid":387,"text":"Lett. “faccia”."}]}],"22287":[{"footnoteId":7182,"paragraphs":[{"pid":388,"text":"O “amore leale”."}]}],"22288":[{"footnoteId":7183,"paragraphs":[{"pid":389,"text":"Lett. “taglierò”."}]}],"22289":[{"footnoteId":7184,"paragraphs":[{"pid":390,"text":"O “la misericordia”."}]},{"footnoteId":7185,"par