7207,"paragraphs":[{"pid":413,"text":"Cioè quando subiranno la punizione come una bestia subisce il giogo."}]}],"22352":[{"footnoteId":7208,"paragraphs":[{"pid":414,"text":"O “metta le briglie”."}]}],"22356":[{"footnoteId":7209,"paragraphs":[{"pid":415,"text":"Lett. “ridotto al silenzio”."}]}],"22358":[{"footnoteId":7210,"paragraphs":[{"pid":416,"text":"Si riferisce ai profeti e ad altri mandati a istruire Israele."}]}],"22360":[{"footnoteId":7211,"paragraphs":[{"pid":417,"text":"O “le funi della premura”. Forse nel versetto si allude a un genitore che insegna al bambino a camminare usando delle corde, o dande."}]}],"22363":[{"footnoteId":7212,"paragraphs":[{"pid":418,"text":"Cioè a praticare un’elevata forma di adorazione."}]}],"22368":[{"footnoteId":7213,"paragraphs":[{"pid":419,"text":"O “vaga”."}]}],"22373":[{"footnoteId":7214,"paragraphs":[{"pid":420,"text":"O “il suo memoriale”."}]}],"22375":[{"footnoteId":7215,"paragraphs":[{"pid":421,"text":"O “mercante”."}]}],"22377":[{"footnoteId":7216,"paragraphs":[{"pid":422,"text":"Lett. “tempo”."}]}],"22379":[{"footnoteId":7217,"paragraphs":[{"pid":423,"text":"O “ciò che è soprannaturale”, “ciò che è mistico”."}]}],"22380":[{"footnoteId":7218,"paragraphs":[{"pid":424,"text":"Lett. “campo”."}]},{"footnoteId":7219,"paragraphs":[{"pid":425,"text":"O “Siria”."}]}],"22384":[{"footnoteId":7220,"paragraphs":[{"pid":426,"text":"O “metallo fuso”."}]}],"22385":[{"footnoteId":7221,"paragraphs":[{"pid":427,"text":"Vedi Glossario."}]}],"22390":[{"footnoteId":7222,"paragraphs":[{"pid":428,"text":"Lett. “l’involucro del loro cuore”."}]}],"22392":[{"footnoteId":7223,"paragraphs":[{"pid":429,"text":"Lett. “giudici”."}]}],"22394":[{"footnoteId":7224,"paragraphs":[{"pid":430,"text":"O “avvolta”."}]}],"22396":[{"footnoteId":7225,"paragraphs":[{"pid":431,"text":"O “Scèol”, cioè il luogo simbolico in cui si trovano i morti. Vedi Glossario."}]}],"22400":[{"footnoteId":7226,"paragraphs":[{"pid":432,"text":"Lett. “e noi offriremo in cambio i giovani tori delle nostre labbra”."}]}],"22401":[{"footnoteId":7227,"paragraphs":[{"pid":433,"text":"O “orfano di padre”."}]}],"22405":[{"footnoteId":7228,"paragraphs":[{"pid":434,"text":"Lett. “memoriale”."}]}]}