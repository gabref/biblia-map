{"22211":[{"footnoteId":7125,"paragraphs":[{"pid":331,"text":"Lett. “parola”."}]},{"footnoteId":7126,"paragraphs":[{"pid":332,"text":"Forma abbreviata di Osaìa, che significa “salvato da Iah”, “Iah ha salvato”."}]},{"footnoteId":7127,"paragraphs":[{"pid":333,"text":"O “Ozìa”."}]},{"footnoteId":7128,"paragraphs":[{"pid":334,"text":"O “Jòas”."}]}],"22212":[{"footnoteId":7129,"paragraphs":[{"pid":335,"text":"Lett. “donna di prostituzione (immoralità, promiscuità sessuale)”."}]},{"footnoteId":7130,"paragraphs":[{"pid":336,"text":"Lett. “figli di prostituzione (immoralità, promiscuità sessuale)”."}]},{"footnoteId":7131,"paragraphs":[{"pid":337,"text":"O “immoralità sessuale”, “promiscuità sessuale”."}]}],"22214":[{"footnoteId":7132,"paragraphs":[{"pid":338,"text":"Significa “Dio seminerà seme”."}]},{"footnoteId":7133,"paragraphs":[{"pid":339,"text":"La città reale dove risiedevano i re del regno settentrionale d’Israele, benché la capitale fosse Samarìa. Vedi 1Re 21:1."}]}],"22215":[{"footnoteId":7134,"paragraphs":[{"pid":340,"text":"O “Bassopiano”."}]}],"22216":[{"footnoteId":7135,"paragraphs":[{"pid":341,"text":"Significa “non le è stata mostrata misericordia”."}]}],"22219":[{"footnoteId":7136,"paragraphs":[{"pid":342,"text":"Significa “non è il mio popolo”."}]}],"22222":[{"footnoteId":7137,"paragraphs":[{"pid":343,"text":"Vedi nt. a Os 1:9."}]},{"footnoteId":7138,"paragraphs":[{"pid":344,"text":"Vedi nt. a Os 1:6."}]}],"22223":[{"footnoteId":7139,"paragraphs":[{"pid":345,"text":"O “immoralità sessuale”, “promiscuità sessuale”."}]}],"22225":[{"footnoteId":7140,"paragraphs":[{"pid":346,"text":"O “immoralità sessuale”, “promiscuità sessuale”."}]}],"22226":[{"footnoteId":7141,"paragraphs":[{"pid":347,"text":"O “ha praticato l’immoralità sessuale”."}]}],"22228":[{"footnoteId":7142,"paragraphs":[{"pid":348,"text":"O “mio marito, il primo”."}]}],"22231":[{"footnoteId":7143,"paragraphs":[{"pid":349,"text":"O “la svergognerò”."}]}],"22236":[{"footnoteId":7144,"paragraphs":[{"p