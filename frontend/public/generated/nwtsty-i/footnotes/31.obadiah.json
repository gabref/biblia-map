{"22627":[{"footnoteId":7345,"paragraphs":[{"pid":36,"text":"Significa “servitore di Geova”."}]},{"footnoteId":7346,"paragraphs":[{"pid":37,"text":"Lett. “lei”, cioè Èdom in quanto nazione."}]}],"22630":[{"footnoteId":7347,"paragraphs":[{"pid":38,"text":"O forse “volassi in alto”."}]}],"22631":[{"footnoteId":7348,"paragraphs":[{"pid":39,"text":"O forse “Quanta distruzione causerebbero?”"}]}],"22633":[{"footnoteId":7349,"paragraphs":[{"pid":40,"text":"O “quelli uniti a te da un patto”."}]}],"22637":[{"footnoteId":7350,"paragraphs":[{"pid":41,"text":"Cioè per dividersi il bottino."}]}],"22644":[{"footnoteId":7351,"paragraphs":[{"pid":42,"text":"O “stoppia”."}]}],"22646":[{"footnoteId":7352,"paragraphs":[{"pid":43,"text":"O “fortificazione”."}]},{"footnoteId":7353,"paragraphs":[{"pid":44,"text":"O “Zàrefat”."}]}]}