{"22904":[{"footnoteId":7481,"paragraphs":[{"pid":97,"text":"Lett. “parola”."}]},{"footnoteId":7482,"paragraphs":[{"pid":98,"text":"Significa “Geova ha nascosto (tesoreggiato)”."}]}],"22906":[{"footnoteId":7483,"paragraphs":[{"pid":99,"text":"A quanto pare attività o oggetti legati all’idolatria."}]}],"22912":[{"footnoteId":7484,"paragraphs":[{"pid":100,"text":"O “podio”, “soglia”. Forse si riferisce alla pedana su cui era posto il trono del re."}]}],"22914":[{"footnoteId":7485,"paragraphs":[{"pid":101,"text":"A quanto pare una zona di Gerusalemme vicina alla Porta dei Pesci."}]},{"footnoteId":7486,"paragraphs":[{"pid":102,"text":"O “mercanti”."}]},{"footnoteId":7487,"paragraphs":[{"pid":103,"text":"Lett. “ridotti al silenzio”."}]}],"22915":[{"footnoteId":7488,"paragraphs":[{"pid":104,"text":"Lett. “si rapprendono sulle loro fecce”, come sul fondo di un tino."}]}],"22917":[{"footnoteId":7489,"paragraphs":[{"pid":105,"text":"O “e si affretta rapidamente”."}]}],"22920":[{"footnoteId":7490,"paragraphs":[{"pid":106,"text":"Lett. “intestini”."}]}],"22923":[{"footnoteId":7491,"paragraphs":[{"pid":107,"text":"Vedi Glossario."}]}],"22924":[{"footnoteId":7492,"paragraphs":[{"pid":108,"text":"O “mansueti”."}]},{"footnoteId":7493,"paragraphs":[{"pid":109,"text":"Lett. “il suo giudizio”."}]},{"footnoteId":7494,"paragraphs":[{"pid":110,"text":"O “mansuetudine”."}]},{"footnoteId":7495,"paragraphs":[{"pid":111,"text":"O “forse”."}]}],"22925":[{"footnoteId":7496,"paragraphs":[{"pid":112,"text":"O “a mezzogiorno”."}]}],"22928":[{"footnoteId":7497,"paragraphs":[{"pid":113,"text":"O “si prenderà cura di loro”."}]}],"22929":[{"footnoteId":7498,"paragraphs":[{"pid":114,"text":"O “biasimi”."}]}],"22932":[{"footnoteId":7499,"paragraphs":[{"pid":115,"text":"O “sarà tremendo con loro”."}]},{"footnoteId":7500,"paragraphs":[{"pid":116,"text":"O “adoreranno”."}]}],"22935":[{"footnoteId":7501,"paragraphs":[{"pid":117,"text":"Lett. “tutte le bestie di una nazione”."}]}],"22936":[{"footnoteId":7502,"paragraphs":[{"pid":118,"text":"Lett. “fischierà e agiterà il suo pugno”."}]}],"22943":[{"footnoteId":7503,"paragraphs":[{"pid":119,"text":"O “punirla”."}]}],"22944":[{"footnoteId":7504,"paragraphs":[{"pid":120,"text":"O “aspettatemi pazientemente”."}]},{"footnoteId":7505,"paragraphs":[{"pid":121,"text":"O forse “agirò da testimone”."}]}],"22945":[{"footnoteId":7506,"paragraphs":[{"pid":122,"text":"O “adorarlo in unità”."}]}],"22952":[{"footnoteId":7507,"paragraphs":[{"pid":123,"text":"Lett. “non cadano le tue mani”."}]}],"22953":[{"footnoteId":7508,"paragraphs":[{"pid":124,"text":"O “sarà quieto (soddisfatto)”."}]}],"22955":[{"footnoteId":7509,"paragraphs":[{"pid":125,"text":"Cioè un nome famoso."}]}],"22956":[{"footnoteId":7510,"paragraphs":[{"pid":126,"text":"Cioè un nome famoso."}]}]}