{"23206":[{"footnoteId":7301,"paragraphs":[{"pid":47,"text":"Meaning “My Messenger.”"}]}],"23211":[{"footnoteId":7302,"paragraphs":[{"pid":48,"text":"Or “grand master.”"}]},{"footnoteId":7303,"paragraphs":[{"pid":49,"text":"Or “respect.”"}]}],"23212":[{"footnoteId":7304,"paragraphs":[{"pid":50,"text":"Lit., “bread.”"}]}],"23214":[{"footnoteId":7305,"paragraphs":[{"pid":51,"text":"Or “soften the face of.”"}]}],"23215":[{"footnoteId":7306,"paragraphs":[{"pid":52,"text":"Evidently, the doors of the temple, as a duty."}]}],"23216":[{"footnoteId":7307,"paragraphs":[{"pid":53,"text":"Or “from east to west.”"}]}],"23217":[{"footnoteId":7308,"paragraphs":[{"pid":54,"text":"Or possibly, “profaning me.”"}]}],"23219":[{"footnoteId":7309,"paragraphs":[{"pid":55,"text":"Or “defective.”"}]}],"23222":[{"footnoteId":7310,"paragraphs":[{"pid":56,"text":"Lit., “rebuke.”"}]},{"footnoteId":7311,"paragraphs":[{"pid":57,"text":"That is, to the place where dung from sacrifices was deposited."}]}],"23224":[{"footnoteId":7312,"paragraphs":[{"pid":58,"text":"Or “respect; reverence.”"}]}],"23225":[{"footnoteId":7313,"paragraphs":[{"pid":59,"text":"Or “instruction.”"}]}],"23226":[{"footnoteId":7314,"paragraphs":[{"pid":60,"text":"Or “instruction.”"}]}],"23227":[{"footnoteId":7315,"paragraphs":[{"pid":61,"text":"Or possibly, “by your instruction.”"}]}],"23230":[{"footnoteId":7316,"paragraphs":[{"pid":62,"text":"Or possibly, “the sanctuary.”"}]}],"23231":[{"footnoteId":7317,"paragraphs":[{"pid":63,"text":"Lit., “one who is awake and one who answers.”"}]}],"23232":[{"footnoteId":7318,"paragraphs":[{"pid":64,"text":"Lit., “a second.”"}]}],"23233":[{"footnoteId":7319,"paragraphs":[{"pid":65,"text":"Or “your legal wife.”"}]}],"23234":[{"footnoteId":7320,"paragraphs":[{"pid":66,"text":"Lit., “seed.”"}]}],"23235":[{"footnoteId":7321,"paragraphs":[{"pid":67,"text":"Lit., “he hates.”"}]},{"footnoteId":7322,"paragraphs":[{"pid":68,"text":"Or “who engages in violence.”"}]}],"23237":[{"footnoteId":7323,"pa