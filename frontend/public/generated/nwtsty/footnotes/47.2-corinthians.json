{"28955":[{"footnoteId":7807,"paragraphs":[{"pid":66,"text":"Or “light.”"}]}],"28959":[{"footnoteId":7808,"paragraphs":[{"pid":67,"text":"Or possibly, “but not left in despair.”"}]}],"28968":[{"footnoteId":7809,"paragraphs":[{"pid":68,"text":"Lit., “weight.”"}]}],"28979":[{"footnoteId":7810,"paragraphs":[{"pid":69,"text":"Or “be made manifest.”"}]}],"28999":[{"footnoteId":7811,"paragraphs":[{"pid":70,"text":"Or “disciplined.”"}]}],"29016":[{"footnoteId":7812,"paragraphs":[{"pid":71,"text":"Or “for an hour.”"}]}],"29047":[{"footnoteId":7813,"paragraphs":[{"pid":72,"text":"Lit., “sharer.”"}]}],"29074":[{"footnoteId":7814,"paragraphs":[{"pid":73,"text":"Lit., “what we are in word.”"}]},{"footnoteId":7815,"paragraphs":[{"pid":74,"text":"Lit., “also be in action.”"}]}],"29076":[{"footnoteId":7816,"paragraphs":[{"pid":75,"text":"Or “apportioned by measure to us.”"}]}],"29084":[{"footnoteId":7817,"paragraphs":[{"pid":76,"text":"Or “purity.”"}]}],"29109":[{"footnoteId":7818,"paragraphs":[{"pid":77,"text":"Or “the daily pressure on me.”"}]}],"29126":[{"footnoteId":7819,"paragraphs":[{"pid":78,"text":"Or “and miracles.”"}]}],"29137":[{"footnoteId":7820,"paragraphs":[{"pid":79,"text":"Or “come back.”"}]}]}