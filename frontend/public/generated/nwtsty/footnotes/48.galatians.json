{"29178":[{"footnoteId":7821,"paragraphs":[{"pid":42,"text":"Lit., “an hour.”"}]}],"29184":[{"footnoteId":7822,"paragraphs":[{"pid":43,"text":"Or “he stood condemned.”"}]}],"29194":[{"footnoteId":7823,"paragraphs":[{"pid":44,"text":"Or “shove aside.”"}]}],"29196":[{"footnoteId":7824,"paragraphs":[{"pid":45,"text":"Lit., “learn from.”"}]}],"29199":[{"footnoteId":7825,"paragraphs":[{"pid":46,"text":"Or “performs miracles.”"}]}],"29237":[{"footnoteId":7826,"paragraphs":[{"pid":47,"text":"Or “temptation.” Lit., “testing.”"}]},{"footnoteId":7827,"paragraphs":[{"pid":48,"text":"Or “spit at me.”"}]}],"29242":[{"footnoteId":7828,"paragraphs":[{"pid":49,"text":"Or “takes shape.”"}]}],"29243":[{"footnoteId":7829,"paragraphs":[{"pid":50,"text":"Or possibly, “and change my tone of voice.” Lit., “and change my voice.”"}]}],"29259":[{"footnoteId":7830,"paragraphs":[{"pid":51,"text":"Lit., “hope of righteousness.”"}]}],"29291":[{"footnoteId":7831,"paragraphs":[{"pid":52,"text":"Or possibly, “with what a long letter.”"}]}],"29297":[{"footnoteId":7832,"paragraphs":[{"pid":53,"text":"Or “Finally.”"}]}]}