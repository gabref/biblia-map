{"29306":[{"footnoteId":7833,"paragraphs":[{"pid":35,"text":"Or “insight; good sense.”"}]}],"29310":[{"footnoteId":7834,"paragraphs":[{"pid":36,"text":"Or “we who have hoped beforehand.”"}]}],"29323":[{"footnoteId":7835,"paragraphs":[{"pid":37,"text":"Or “the course; the ways; the customs.”"}]}],"29352":[{"footnoteId":7836,"paragraphs":[{"pid":38,"text":"Or “should bring to light.”"}]}],"29359":[{"footnoteId":7837,"paragraphs":[{"pid":39,"text":"Or “riches.”"}]}],"29362":[{"footnoteId":7838,"paragraphs":[{"pid":40,"text":"Or “may be filled up to all.”"}]}],"29372":[{"footnoteId":7839,"paragraphs":[{"pid":41,"text":"Or possibly, “he says.”"}]}],"29374":[{"footnoteId":7840,"paragraphs":[{"pid":42,"text":"Or “he might bring all things to fulfillment.”"}]}],"29409":[{"footnoteId":7841,"paragraphs":[{"pid":43,"text":"Or “reproved.”"}]}],"29410":[{"footnoteId":7842,"paragraphs":[{"pid":44,"text":"Or possibly, “he says.”"}]}],"29415":[{"footnoteId":7843,"paragraphs":[{"pid":45,"text":"Or possibly, “to yourselves.”"}]}],"29416":[{"footnoteId":7844,"paragraphs":[{"pid":46,"text":"Lit., “to the.”"}]}],"29432":[{"footnoteId":7845,"paragraphs":[{"pid":47,"text":"Or “That you may prosper.”"}]}],"29438":[{"footnoteId":7846,"paragraphs":[{"pid":48,"text":"Or “Lord.”"}]}],"29442":[{"footnoteId":7847,"paragraphs":[{"pid":49,"text":"Or “withstand; stand your ground.”"}]}]}