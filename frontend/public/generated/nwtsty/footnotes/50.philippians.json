{"29475":[{"footnoteId":7848,"paragraphs":[{"pid":29,"text":"Or possibly, “I do not know.”"}]}],"29490":[{"footnoteId":7849,"paragraphs":[{"pid":30,"text":"Lit., “came to be in the likeness of humans.”"}]}],"29507":[{"footnoteId":7850,"paragraphs":[{"pid":31,"text":"Or “I trust.”"}]}],"29520":[{"footnoteId":7851,"paragraphs":[{"pid":32,"text":"Or possibly, “have willingly abandoned.”"}]}],"29525":[{"footnoteId":7852,"paragraphs":[{"pid":33,"text":"Lit., “laid hold on me.”"}]}],"29542":[{"footnoteId":7853,"paragraphs":[{"pid":34,"text":"Lit., “as many (things) as.”"}]}]}