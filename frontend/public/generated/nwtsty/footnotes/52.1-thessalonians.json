{"29678":[{"footnoteId":7862,"paragraphs":[{"pid":28,"text":"Or “as they keep on forbidding us to speak.”"}]},{"footnoteId":7863,"paragraphs":[{"pid":29,"text":"Or possibly, “has come upon them completely.”"}]}],"29679":[{"footnoteId":7864,"paragraphs":[{"pid":30,"text":"Lit., “to see your face.”"}]}],"29684":[{"footnoteId":7865,"paragraphs":[{"pid":31,"text":"Or “to strengthen you.”"}]}],"29685":[{"footnoteId":7866,"paragraphs":[{"pid":32,"text":"Lit., “swayed.”"}]}],"29692":[{"footnoteId":7867,"paragraphs":[{"pid":33,"text":"Or “see you face-to-face.” Lit., “see your face.”"}]}],"29697":[{"footnoteId":7868,"paragraphs":[{"pid":34,"text":"Or “orders.”"}]}],"29708":[{"footnoteId":7869,"paragraphs":[{"pid":35,"text":"Or “uninformed.”"}]}]}