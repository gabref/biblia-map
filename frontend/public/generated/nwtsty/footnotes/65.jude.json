{"30768":[{"footnoteId":8022,"paragraphs":[{"pid":13,"text":"Or “shameless conduct.” Greek, a·selʹgei·a. See Glossary."}]},{"footnoteId":8023,"paragraphs":[{"pid":14,"text":"Or “master.”"}]}],"30769":[{"footnoteId":8024,"paragraphs":[{"pid":15,"text":"See App. A5."}]}],"30771":[{"footnoteId":8025,"paragraphs":[{"pid":16,"text":"See Glossary."}]}],"30773":[{"footnoteId":8026,"paragraphs":[{"pid":17,"text":"See App. A5."}]}],"30776":[{"footnoteId":8027,"paragraphs":[{"pid":18,"text":"Or “being completely dead.”"}]}],"30778":[{"footnoteId":8028,"paragraphs":[{"pid":19,"text":"See App. A5."}]},{"footnoteId":8029,"paragraphs":[{"pid":20,"text":"Or “tens of thousands.”"}]}],"30780":[{"footnoteId":8030,"paragraphs":[{"pid":21,"text":"Or “admiring personalities.”"}]}],"30781":[{"footnoteId":8031,"paragraphs":[{"pid":22,"text":"Or “the things foretold.”"}]}],"30783":[{"footnoteId":8032,"paragraphs":[{"pid":23,"text":"Or “physical men.”"}]},{"footnoteId":8033,"paragraphs":[{"pid":24,"text":"Lit., “the spirit.”"}]}],"30788":[{"footnoteId":8034,"paragraphs":[{"pid":25,"text":"Or “in his glorious presence.”"}]}]}