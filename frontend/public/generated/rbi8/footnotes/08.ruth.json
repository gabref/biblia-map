{"7129":[{"footnoteId":2240,"paragraphs":[{"pid":30,"text":"Meaning “God Is King.”"}]},{"footnoteId":2241,"paragraphs":[{"pid":31,"text":"Or, “inhabitants of Ephrath.” See Ge 35:16, 19."}]}],"7132":[{"footnoteId":2242,"paragraphs":[{"pid":32,"text":"Meaning “Sickly; Invalid.”"}]},{"footnoteId":2243,"paragraphs":[{"pid":33,"text":"Meaning “Frailty.”"}]}],"7133":[{"footnoteId":2244,"paragraphs":[{"pid":34,"text":"Or, “had visited.”"}]}],"7135":[{"footnoteId":2245,"paragraphs":[{"pid":35,"text":"Or, “loyal love.”"}]}],"7140":[{"footnoteId":2246,"paragraphs":[{"pid":36,"text":"“Them,” masc., LXXSyVg."}]}],"7142":[{"footnoteId":2247,"paragraphs":[{"pid":37,"text":"That is, the widow of the brother of a wife’s husband. See De 25:5, 7."}]}],"7143":[{"footnoteId":2248,"paragraphs":[{"pid":38,"text":"Or, “from following you.” Lit., “from after you.” Heb., me·ʼa·charaʹyikh. Compare Ge 16:13 ftn, “Him”; Jg 13:11 ftn."}]}],"7147":[{"footnoteId":2249,"paragraphs":[{"pid":39,"text":"Meaning “My Pleasantness.”"}]},{"footnoteId":2250,"paragraphs":[{"pid":40,"text":"Meaning “Bitter.”"}]},{"footnoteId":2251,"paragraphs":[{"pid":41,"text":"“The Almighty.” Heb., Shad·daiʹ; Syr., ʼEl·Shad·dai, “God Almighty”; Lat., O·mniʹpo·tens. See Re 1:8 ftn, “Almighty.”"}]}],"7150":[{"footnoteId":2252,"paragraphs":[{"pid":42,"text":"Or, “acquaintance.”"}]},{"footnoteId":2253,"paragraphs":[{"pid":43,"text":"Possibly meaning “In Strength.”"}]}],"7162":[{"footnoteId":2254,"paragraphs":[{"pid":44,"text":"Lit., “spoken to the heart of.”"}]}],"7166":[{"footnoteId":2255,"paragraphs":[{"pid":45,"text":"About 22 L (20 dry qt)."}]}],"7167":[{"footnoteId":2256,"paragraphs":[{"pid":46,"text":"“And her mother-in-law got to see,” MLXX; SyVg, “and showed her mother-in-law.”"}]}],"7169":[{"footnoteId":2257,"paragraphs":[{"pid":47,"text":"Or, “one of our kinsmen with the right to repurchase (redeem).” Heb., mig·go·ʼaleʹnu, sing.; pl. in several Heb. mss."}]}],"7177":[{"footnoteId":2258,"paragraphs":[{"pid":48,"text":"“To me,” TSy. Many Heb. mss do not have these words but have the qere vowel points for these words after “say.” Compare Jg 20:13 ftn."}]}],"7183":[{"footnoteId":2259,"paragraphs":[{"pid":49,"text":"Or, “city.”"}]}],"7187":[{"footnoteId":2260,"paragraphs":[{"pid":50,"text":"According to rabbinical sources these were six seah measures, or 44 L (40 dry qt). This was likely all that she could carry on her head."}]},{"footnoteId":2261,"paragraphs":[{"pid":51,"text":"“He,” M; SyVg, “she.”"}]}],"7189":[{"footnoteId":2262,"paragraphs":[{"pid":52,"text":"“To me,” TLXXSy and the qere vowel points of many Heb. mss. See vs 5 ftn."}]}],"7191":[{"footnoteId":2263,"paragraphs":[{"pid":53,"text":"“So-and-so.” Heb., Pelo·niʹ ʼAl·mo·niʹ."}]}],"7192":[{"footnoteId":2264,"paragraphs":[{"pid":54,"text":"Or, “elders.”"}]}],"7194":[{"footnoteId":2265,"paragraphs":[{"pid":55,"text":"Lit., “I said [to myself].”"}]},{"footnoteId":2266,"paragraphs":[{"pid":56,"text":"Lit., “I should uncover your ear.”"}]}],"7197":[{"footnoteId":2267,"paragraphs":[{"pid":57,"text":"“Custom,” LXXSyVg; M omits."}]}],"7198":[{"footnoteId":2268,"paragraphs":[{"pid":58,"text":"“The repurchaser (goel).” Heb., hag·go·ʼelʹ. See Nu 5:8; 35:12."}]},{"footnoteId":2269,"paragraphs":[{"pid":59,"text":"LXX adds, “and give it to him.”"}]}],"7201":[{"footnoteId":2270,"paragraphs":[{"pid":60,"text":"Or, “woman.” TSy, “this wife of yours”; LXX, “your wife.”"}]},{"footnoteId":2271,"paragraphs":[{"pid":61,"text":"Lit., “and proclaim a name.” See vs 14."}]}],"7204":[{"footnoteId":2272,"paragraphs":[{"pid":62,"text":"“His,” MSyVg; LXXIt, “your.”"}]}],"7205":[{"footnoteId":2273,"paragraphs":[{"pid":63,"text":"Or, “a bringer back of your life [Heb., neʹphesh; Gr., psy·khenʹ; Lat., aʹni·mam].”"}]}],"7207":[{"footnoteId":2274,"paragraphs":[{"pid":64,"text":"Meaning “Servant; One Serving.”"}]}],"7210":[{"footnoteId":2275,"paragraphs":[{"pid":65,"text":"“Salmon,” LXXAVgc, several Heb. mss and Armenian, Ethiopic and Sahidic versions; M, “Salma”; LXXB, “Salman.”"}]}],"7211":[{"footnoteId":2276,"paragraphs":[{"pid":66,"text":"“Salmon,” MLXXAVgc; LXXB, “Salman.” See Mt 1:4, 5; Lu 3:31-33."}]}]}