{"17654":[{"footnoteId":5931,"paragraphs":[{"pid":56,"text":"Or, “The most beautiful (most excellent) song.” Lit., “Song of the songs.”"}]}],"17655":[{"footnoteId":5932,"paragraphs":[{"pid":57,"text":"Lit., “your endearments.” Heb., do·dheyʹkha."}]}],"17657":[{"footnoteId":5933,"paragraphs":[{"pid":58,"text":"Or, “after.” See Jg 13:11 ftn; Ru 1:16 ftn."}]}],"17669":[{"footnoteId":5934,"paragraphs":[{"pid":59,"text":"“You are beautiful,” masc., referring to her shepherd lover."}]}],"17670":[{"footnoteId":5935,"paragraphs":[{"pid":60,"text":"Lit., “our houses.”"}]}],"17671":[{"footnoteId":5936,"paragraphs":[{"pid":61,"text":"Or, “crocus; asphodel.”"}]},{"footnoteId":5937,"paragraphs":[{"pid":62,"text":"“The coastal plain.” Or, “Sharon.” Heb., hash·sha·rohnʹ."}]}],"17674":[{"footnoteId":5938,"paragraphs":[{"pid":63,"text":"“Love.” Heb., ʼa·havahʹ."}]}],"17681":[{"footnoteId":5939,"paragraphs":[{"pid":64,"text":"Or, “the winter.”"}]}],"17687":[{"footnoteId":5940,"paragraphs":[{"pid":65,"text":"Or, “cleft mountains.” Lit., “mountains of Bether.” The meaning of “Bether” is uncertain."}]}],"17693":[{"footnoteId":5941,"paragraphs":[{"pid":66,"text":"Lit., “Who,” with a fem. predicate."}]}],"17694":[{"footnoteId":5942,"paragraphs":[{"pid":67,"text":"“Mighty men.” Heb., gib·bo·rimʹ."}]}],"17697":[{"footnoteId":5943,"paragraphs":[{"pid":68,"text":"Or, “with ebony,” by a correction of M."}]}],"17702":[{"footnoteId":5944,"paragraphs":[{"pid":69,"text":"“The mighty men.” Heb., hag·gib·boh·rimʹ."}]}],"17706":[{"footnoteId":5945,"paragraphs":[{"pid":70,"text":"Lit., “Amanah.”"}]}],"17707":[{"footnoteId":5946,"paragraphs":[{"pid":71,"text":"Or, “you have encouraged me.”"}]}],"17710":[{"footnoteId":5947,"paragraphs":[{"pid":72,"text":"“Garden,” LXXSyVg and many Heb. mss; M, “wave.”"}]}],"17711":[{"footnoteId":5948,"paragraphs":[{"pid":73,"text":"Lit., “park [preserve].” Heb., par·desʹ; LXXVg, “paradise”; Syr., par·dai·saʼ."}]},{"footnoteId":5949,"paragraphs":[{"pid":74,"text":"Lit., “pomegranate trees.”"}]}],"17713":[{"footnoteId":5950,"paragraphs":[{"pid":75,"text":"Lit., “living waters.” Heb., maʹyim chai·yimʹ."}]}],"17715":[{"footnoteId":5951,"paragraphs":[{"pid":76,"text":"Or, “become drunk, O dear ones!”"}]}],"17718":[{"footnoteId":5952,"paragraphs":[{"pid":77,"text":"“Within me,” more than 50 Heb. mss and some printed Heb. ed.; MLXXSyVg, “over him.”"}]}],"17719":[{"footnoteId":5953,"paragraphs":[{"pid":78,"text":"Lit., “current (passing along).”"}]},{"footnoteId":5954,"paragraphs":[{"pid":79,"text":"That is, the hollow into which the door bolt is pushed."}]}],"17724":[{"footnoteId":5955,"paragraphs":[{"pid":80,"text":"Lit., “lifted up like a banner.”"}]}],"17728":[{"footnoteId":5956,"paragraphs":[{"pid":81,"text":"“With chrysolite.” Heb., bat·tar·shishʹ."}]}],"17734":[{"footnoteId":5957,"paragraphs":[{"pid":82,"text":"Or, “like Tirzah.”"}]}],"17742":[{"footnoteId":5958,"paragraphs":[{"pid":83,"text":"MLXX end chapter 6 here."}]}],"17743":[{"footnoteId":5959,"paragraphs":[{"pid":84,"text":"SyVg end chapter 6 here."}]},{"footnoteId":5960,"paragraphs":[{"pid":85,"text":"Or, “dance of Mahanaim.”"}]}],"17749":[{"footnoteId":5961,"paragraphs":[{"pid":86,"text":"Lit., “O love.”"}]}],"17754":[{"footnoteId":5962,"paragraphs":[{"pid":87,"text":"“The villages,” LXXSyVg. But see 1:14; 4:13."}]}],"17761":[{"footnoteId":5963,"paragraphs":[{"pid":88,"text":"“You,” masc."}]}],"17762":[{"footnoteId":5964,"paragraphs":[{"pid":89,"text":"“Your,” masc."}]},{"footnoteId":5965,"paragraphs":[{"pid":90,"text":"“As Sheol.” Heb., khish·ʼohlʹ; Gr., haiʹdes; Lat., inʹfer·us. See App 4B."}]},{"footnoteId":5966,"paragraphs":[{"pid":91,"text":"“Jah.” This is the only place in The Song of Solomon where the divine name occurs, here in abbreviated form. See Gins.Int, pp. 386, 387; Ps 68:4 ftn; App 1A."}]}],"17763":[{"footnoteId":5967,"paragraphs":[{"pid":92,"text":"“Man.” Heb., ʼish."}]},{"footnoteId":5968,"paragraphs":[{"pid":93,"text":"Or, “him.”"}]}],"17767":[{"footnoteId":5969,"paragraphs":[{"pid":94,"text":"Or, “a thousand pieces of money.”"}]}],"17768":[{"footnoteId":5970,"paragraphs":[{"pid":95,"text":"Lit., “is before me.”"}]}],"17769":[{"footnoteId":5971,"paragraphs":[{"pid":96,"text":"“You,” and “your,” both fem."}]}],"17770":[{"footnoteId":5972,"paragraphs":[{"pid":97,"text":"“Yourself,” masc. Compare 2:8, 9, 16, 17."}]}]}