{"22696":[{"footnoteId":8607,"paragraphs":[{"pid":46,"text":"See App 1C §2."}]},{"footnoteId":8608,"paragraphs":[{"pid":47,"text":"Or, “the Morashtite.”"}]}],"22697":[{"footnoteId":8609,"paragraphs":[{"pid":48,"text":"One of 134 scribal changes from YHWH to ʼAdho·naiʹ. See App 1B."}]},{"footnoteId":8610,"paragraphs":[{"pid":49,"text":"“From his holy temple.” Heb., me·heh·khalʹ qodh·shohʹ; Lat., temʹplo sancʹto. See Mt 23:16 ftn."}]}],"22698":[{"footnoteId":8611,"paragraphs":[{"pid":50,"text":"See App 1C §2."}]}],"22700":[{"footnoteId":8612,"paragraphs":[{"pid":51,"text":"“The high places,” MVg; LXX, “the sin of the house”; Sy, “the sin.”"}]}],"22703":[{"footnoteId":8613,"paragraphs":[{"pid":52,"text":"“Female ostriches.” Lit., “daughters of an ostrich.”"}]}],"22704":[{"footnoteId":8614,"paragraphs":[{"pid":53,"text":"“Stroke,” LXXSyVg; M, “strokes.”"}]}],"22708":[{"footnoteId":8615,"paragraphs":[{"pid":54,"text":"“You,” fem. sing."}]}],"22710":[{"footnoteId":8616,"paragraphs":[{"pid":55,"text":"Or, “The one taking possession.”"}]}],"22713":[{"footnoteId":8617,"paragraphs":[{"pid":56,"text":"“An able-bodied man.” Heb., geʹver."}]},{"footnoteId":8618,"paragraphs":[{"pid":57,"text":"“A man.” Heb., weʼishʹ."}]}],"22716":[{"footnoteId":8619,"paragraphs":[{"pid":58,"text":"“In the congregation of.” Heb., biq·halʹ; Gr., ek·kle·siʹai. See De 4:10 ftns."}]}],"22718":[{"footnoteId":8620,"paragraphs":[{"pid":59,"text":"Or, “the active force of Jehovah.” Heb., ruʹach Yehwahʹ. See Ge 1:2 ftn, “Force.”"}]}],"22720":[{"footnoteId":8621,"paragraphs":[{"pid":60,"text":"Lit., “she.”"}]}],"22722":[{"footnoteId":8622,"paragraphs":[{"pid":61,"text":"Heb., ʼish."}]},{"footnoteId":8623,"paragraphs":[{"pid":62,"text":"“Wind.” Heb., ruʹach. See Ge 1:2 ftn, “Force.”"}]}],"22723":[{"footnoteId":8624,"paragraphs":[{"pid":63,"text":"Or, “the remnant.”"}]},{"footnoteId":8625,"paragraphs":[{"pid":64,"text":"“In the pen,” by a change of vowel pointing in agreement with TVg; M, “Bozrah.”"}]},{"footnoteId":8626,"paragraphs":[{"pid":65,"text":"“With men.” Heb., me·ʼa·dhamʹ."}]}],"22729":[{"footnoteId":8627,"paragraphs":[{"pid":66,"text":"Or, “err.”"}]}],"22731":[{"footnoteId":8628,"paragraphs":[{"pid":67,"text":"“God.” Heb., ʼElo·himʹ; Lat., Deʹi."}]}],"22735":[{"footnoteId":8629,"paragraphs":[{"pid":68,"text":"Or, “silver.”"}]}],"22738":[{"footnoteId":8630,"paragraphs":[{"pid":69,"text":"Or, “go.”"}]}],"22740":[{"footnoteId":8631,"paragraphs":[{"pid":70,"text":"Or, “dwell.”"}]},{"footnoteId":8632,"paragraphs":[{"pid":71,"text":"“Each one.” Heb., ʼish."}]},{"footnoteId":8633,"paragraphs":[{"pid":72,"text":"See App 1C §2."}]},{"footnoteId":8634,"paragraphs":[{"pid":73,"text":"“Jehovah of armies,” MTVg; LXX, “Jehovah Almighty.”"}]}],"22741":[{"footnoteId":8635,"paragraphs":[{"pid":74,"text":"Or, “its gods.” Heb., ʼelo·havʹ; Syr., ʼa·la·heh; Lat., deʹi."}]},{"footnoteId":8636,"paragraphs":[{"pid":75,"text":"See App 1C §2."}]},{"footnoteId":8637,"paragraphs":[{"pid":76,"text":"“Our God.” Heb., ʼElo·hehʹnu; Gr., The·ouʹ; Lat., Deʹi."}]},{"footnoteId":8638,"paragraphs":[{"pid":77,"text":"Or, “forever and ever.” See Ex 15:18."}]}],"22743":[{"footnoteId":8639,"paragraphs":[{"pid":78,"text":"See App 1C §2."}]}],"22744":[{"footnoteId":8640,"paragraphs":[{"pid":79,"text":"“You,” masc. sing."}]},{"footnoteId":8641,"paragraphs":[{"pid":80,"text":"Or, “of Eder.” Compare Ge 35:21, where “the tower of Eder” occurs."}]},{"footnoteId":8642,"paragraphs":[{"pid":81,"text":"Heb., ʽoʹphel, that is, a hill, or an eminence. Compare 2Ki 5:24 ftn."}]},{"footnoteId":8643,"paragraphs":[{"pid":82,"text":"Or, “former.”"}]}],"22745":[{"footnoteId":8644,"paragraphs":[{"pid":83,"text":"“You,” fem. sing."}]}],"22746":[{"footnoteId":8645,"paragraphs":[{"pid":84,"text":"“Babylon,” LXXVg; MTSy, “Babel.”"}]}],"22749":[{"footnoteId":8646,"paragraphs":[{"pid":85,"text":"“To the [true] Lord.” Ca(Heb.), לָאֲדוֹן (la·ʼAdhohnʹ); Leningrad B 19A(Heb.), לַאֲדוֹן (la·ʼAdhohnʹ); Gr., Ky·riʹoi; Syr., leMa·raʼ; Lat., Doʹmi·no. See App 1H."}]}],"22750":[{"footnoteId":8647,"paragraphs":[{"pid":86,"text":"MLXXSy end chap. 4 here; TLXXBagsterVg begin chap. 5 with this vs."}]}],"22751":[{"footnoteId":8648,"paragraphs":[{"pid":87,"text":"Meaning “House of Bread.” Heb., Behth-leʹchem."}]},{"footnoteId":8649,"paragraphs":[{"pid":88,"text":"“You,” masc. sing."}]},{"footnoteId":8650,"paragraphs":[{"pid":89,"text":"“Origin,” according to BDB, p. 426 and KB, p. 505."}]}],"22753":[{"footnoteId":8651,"paragraphs":[{"pid":90,"text":"See App 1C §2."}]},{"footnoteId":8652,"paragraphs":[{"pid":91,"text":"See App 1C §2."}]},{"footnoteId":8653,"paragraphs":[{"pid":92,"text":"See Jer 16:19 ftn."}]}],"22754":[{"footnoteId":8654,"paragraphs":[{"pid":93,"text":"Possibly, “our soil (ground),” in agreement with LXXSy."}]},{"footnoteId":8655,"paragraphs":[{"pid":94,"text":"Or, “of earthling men.” Heb., ʼa·dhamʹ."}]}],"22756":[{"footnoteId":8656,"paragraphs":[{"pid":95,"text":"Or, “the remainder; the remnant.”"}]},{"footnoteId":8657,"paragraphs":[{"pid":96,"text":"“For man.” Heb., leʼishʹ."}]},{"footnoteId":8658,"paragraphs":[{"pid":97,"text":"Or, “mankind.” Heb., ʼa·dhamʹ."}]}],"22758":[{"footnoteId":8659,"paragraphs":[{"pid":98,"text":"“Your,” masc. sing."}]}],"22763":[{"footnoteId":8660,"paragraphs":[{"pid":99,"text":"Or, “Asherim.”"}]}],"22765":[{"footnoteId":8661,"paragraphs":[{"pid":100,"text":"“Hear, then, Jehovah’s word. Jehovah said,” LXX."}]}],"22769":[{"footnoteId":8662,"paragraphs":[{"pid":101,"text":"Or, “the Acacia Trees.”"}]}],"22772":[{"footnoteId":8663,"paragraphs":[{"pid":102,"text":"Or, “O man.” Heb., ʼa·dhamʹ."}]},{"footnoteId":8664,"paragraphs":[{"pid":103,"text":"Or, “loving-kindness; loyal love.” Heb., cheʹsedh."}]}],"22773":[{"footnoteId":8665,"paragraphs":[{"pid":104,"text":"“It,” fem., hence, not referring to the “rod,” masc., but possibly to the punishment by means of the rod."}]}],"22778":[{"footnoteId":8666,"paragraphs":[{"pid":105,"text":"“And there will exist no power in the midst of you,” by a correction; Sy, “and dysentery will be in your intestines.”"}]}],"22780":[{"footnoteId":8667,"paragraphs":[{"pid":106,"text":"“Peoples,” LXX; MTSyVg, “my people.”"}]}],"22782":[{"footnoteId":8668,"paragraphs":[{"pid":107,"text":"Or, “The one of loving-kindness.” Heb., cha·sidhʹ."}]},{"footnoteId":8669,"paragraphs":[{"pid":108,"text":"Or, “the land.” Heb., ha·ʼaʹrets."}]},{"footnoteId":8670,"paragraphs":[{"pid":109,"text":"Or, “among earthling men.” Heb., ba·ʼa·dhamʹ."}]}],"22786":[{"footnoteId":8671,"paragraphs":[{"pid":110,"text":"“Men of.” Heb., ʼan·shehʹ, pl. of ʼish, which is earlier rendered “a man’s” in this sentence."}]}],"22791":[{"footnoteId":8672,"paragraphs":[{"pid":111,"text":"“Your,” fem. sing."}]},{"footnoteId":8673,"paragraphs":[{"pid":112,"text":"Or, “prescribed limit.”"}]}],"22792":[{"footnoteId":8674,"paragraphs":[{"pid":113,"text":"“They,” LXX; MSyVg, “he,” or “one.”"}]},{"footnoteId":8675,"paragraphs":[{"pid":114,"text":"“Egypt.” Heb., Ma·tsohrʹ."}]}],"22794":[{"footnoteId":8676,"paragraphs":[{"pid":115,"text":"“Your,” masc. sing."}]}],"22797":[{"footnoteId":8677,"paragraphs":[{"pid":116,"text":"“Our God.” Heb., ʼElo·hehʹnu."}]}],"22798":[{"footnoteId":8678,"paragraphs":[{"pid":117,"text":"“God.” Heb., ʼEl; Gr., The·osʹ; Lat., Deʹus."}]},{"footnoteId":8679,"paragraphs":[{"pid":118,"text":"Or, “loyal love.” Heb., cheʹsedh."}]}],"22799":[{"footnoteId":8680,"paragraphs":[{"pid":119,"text":"“Their,” M; LXXSyVg, “our”; T, “Israel’s.”"}]}]}