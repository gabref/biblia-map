9,"paragraphs":[{"pid":284,"text":"Lit., “about it.”"}]}],"25128":[{"footnoteId":9520,"paragraphs":[{"pid":285,"text":"See App 1D."}]}],"25140":[{"footnoteId":9521,"paragraphs":[{"pid":286,"text":"Or, “things.” Gr., rheʹma·ta. See 1:37 ftn."}]}],"25142":[{"footnoteId":9522,"paragraphs":[{"pid":287,"text":"Or, “the emperor.” Gr., Kaiʹsa·ros; Lat., Caeʹsa·ris."}]},{"footnoteId":9523,"paragraphs":[{"pid":288,"text":"That is, Herod Antipas, son of Herod the Great."}]},{"footnoteId":9524,"paragraphs":[{"pid":289,"text":"“District ruler.” Lit., “tetrarch”; a territorial prince for the Roman emperor. Lat., te·trarʹcha."}]}],"25145":[{"footnoteId":9525,"paragraphs":[{"pid":290,"text":"See App 1D."}]}],"25149":[{"footnoteId":9526,"paragraphs":[{"pid":291,"text":"Lit., “change of mind.” Gr., me·ta·noiʹas."}]}],"25155":[{"footnoteId":9527,"paragraphs":[{"pid":292,"text":"Or, “wages.”"}]}],"25160":[{"footnoteId":9528,"paragraphs":[{"pid":293,"text":"See vs 1 ftn, “Ruler.”"}]}],"25162":[{"footnoteId":9529,"paragraphs":[{"pid":294,"text":"Or, “was immersed; was dipped.” Gr., ba·pti·sthenʹtos."}]}],"25164":[{"footnoteId":9530,"paragraphs":[{"pid":295,"text":"Or, “commenced [to teach].”"}]},{"footnoteId":9531,"paragraphs":[{"pid":296,"text":"Or, “as it was established by law.”"}]}],"25168":[{"footnoteId":9532,"paragraphs":[{"pid":297,"text":"Lit., “Salathiel.”"}]}],"25170":[{"footnoteId":9533,"paragraphs":[{"pid":298,"text":"“Jesus,” אBVgSysJ18,22; ASypJ17,21, “Jose(s).”"}]}],"25173":[{"footnoteId":9534,"paragraphs":[{"pid":299,"text":"“Jobel,” א*BSys."}]},{"footnoteId":9535,"paragraphs":[{"pid":300,"text":"“Sala,” א*BSys."}]}],"25174":[{"footnoteId":9536,"paragraphs":[{"pid":301,"text":"“Admin,” א; B, “Admein.”"}]},{"footnoteId":9537,"paragraphs":[{"pid":302,"text":"“Aram,” ADVgSyp. Or, “Ram.” See 1Ch 2:9; Mt 1:3, 4."}]}],"25177":[{"footnoteId":9538,"paragraphs":[{"pid":303,"text":"P75D omit “son of Cainan,” in harmony with Ge 10:24; Ge 11:12, 15; 1Ch 1:18."}]}],"25180":[{"footnot