:"Or, “Master.”"}]}],"25521":[{"footnoteId":9616,"paragraphs":[{"pid":381,"text":"According to אcBCc; P45,75AC*WVgSyc, “One thing, though, is necessary.”"}]}],"25523":[{"footnoteId":9617,"paragraphs":[{"pid":382,"text":"Or, “let . . . be held sacred; let . . . be treated as holy.” Gr., ha·gi·a·stheʹto; Lat., sanc·ti·fi·ceʹtur; J17,18(Heb.), yith·qad·dashʹ."}]}],"25536":[{"footnoteId":9618,"paragraphs":[{"pid":383,"text":"“Beelzebub,” VgSyc,p,s; P45,75ACDW(Gr.), Be·el·ze·boulʹ; אB(Gr.), Be·e·ze·boulʹ. See Mt 12:24 ftn."}]}],"25546":[{"footnoteId":9619,"paragraphs":[{"pid":384,"text":"“Unoccupied, swept clean,” B."}]}],"25547":[{"footnoteId":9620,"paragraphs":[{"pid":385,"text":"Or, “other.”"}]}],"25552":[{"footnoteId":9621,"paragraphs":[{"pid":386,"text":"See Mt 12:42 ftn."}]}],"25555":[{"footnoteId":9622,"paragraphs":[{"pid":387,"text":"Or, “sincere; all one way; in focus; generous.”"}]},{"footnoteId":9623,"paragraphs":[{"pid":388,"text":"Or, “bad; envious.”"}]}],"25559":[{"footnoteId":9624,"paragraphs":[{"pid":389,"text":"Lit., “he was not first dipped (baptized).”"}]}],"25562":[{"footnoteId":9625,"paragraphs":[{"pid":390,"text":"Or, “to you.”"}]}],"25563":[{"footnoteId":9626,"paragraphs":[{"pid":391,"text":"Or, “the judgment.” Gr., ten kriʹsin; Lat., iu·diʹci·um; J17,18,22(Heb.), ham·mish·patʹ."}]}],"25564":[{"footnoteId":9627,"paragraphs":[{"pid":392,"text":"Or, “places of assembly.” Gr., a·go·raisʹ."}]}],"25569":[{"footnoteId":9628,"paragraphs":[{"pid":393,"text":"Lit., “killed them.”"}]}],"25571":[{"footnoteId":9629,"paragraphs":[{"pid":394,"text":"Lit., “a throwing down [of seed].” Gr., ka·ta·bo·lesʹ."}]}],"25576":[{"footnoteId":9630,"paragraphs":[{"pid":395,"text":"Lit., “of the myriads.”"}]}],"25578":[{"footnoteId":9631,"paragraphs":[{"pid":396,"text":"Or, “in public; without privacy.”"}]},{"footnoteId":9632,"paragraphs":[{"pid":397,"text":"Lit., “spoke toward the ear.”"}]}],"25580":[{"footnoteId":9633,"paragraphs":[{"pid":398,"text":"See App 4C."}]}],"25581":[{"footnoteId":9634,"paragraphs":[{"pid":399,"text":"Lit., “for two assarii.” An assarion was one sixteenth of a denarius. See App 8A."}]}],"25586":[{"footnoteId":9635,"paragraphs":[{"pid":400,"text":"Lit., “synagogues.”"}]},{"footnoteId":9636,"paragraphs":[{"pid":401,"text":"“How or what,” אABVg; DItSyc,p, “how”; Sys, “what.”"}]}],"25589":[{"footnoteId":9637,"paragraphs":[{"pid":402,"text":"Or, “divider.”"}]}],"25595":[{"footnoteId":9638,"paragraphs":[{"pid":403,"text":"Or, “life.” Gr., psy·khenʹ; J17,18,22(Heb.), naph·shekhaʹ (from neʹphesh)."}]}],"25611":[{"footnoteId":9639,"paragraphs":[{"pid":404,"text":"Or, “breaks away; departs.” See App 5D."}]},{"footnoteId":9640,"paragraphs":[{"pid":405,"text":"Or, “wedding feast.”"}]}],"25613":[{"footnoteId":9641,"paragraphs":[{"pid":406,"text":"From about 9 p.m. until midnight. See Mr 13:35 ftns."}]},{"footnoteId":9642,"paragraphs":[{"pid":407,"text":"From midnight until about 3 a.m."}]}],"25616":[{"footnoteId":9643,"paragraphs":[{"pid":408,"text":"Or, “Master.”"}]}],"25617":[{"footnoteId":9644,"paragraphs":[{"pid":409,"text":"Or, “house manager.” Gr., oi·ko·noʹmos; Lat., di·spen·saʹtor; J17(Heb.), has·so·khenʹ, “the steward.” See Ge 24:2 ftn; Eph 1:10 ftn, “Administration.”"}]}],"25621":[{"footnoteId":9645,"paragraphs":[{"pid":410,"text":"Or, “will cut him in two.”"}]}],"25634":[{"footnoteId":9646,"paragraphs":[{"pid":411,"text":"Lit., “the last lepton.” See App 8A."}]}],"25638":[{"footnoteId":9647,"paragraphs":[{"pid":412,"text":"“Siloam,” אAB; J17,18,22, “Shiloah.”"}]}],"25643":[{"footnoteId":9648,"paragraphs":[{"pid":413,"text":"Or, “must.”"}]}],"25649":[{"footnoteId":9649,"paragraphs":[{"pid":414,"text":"Or, “Master.”"}]}],"25655":[{"footnoteId":9650,"paragraphs":[{"pid":415,"text":"Or, “mixed with.”"}]},{"footnoteId":9651,"paragraphs":[{"pid":416,"text":"Lit., “seah measures.” Gr., saʹta. A seah measure equaled 7.33 L (6.66 dry qt)."}]}],"25658":[{"footnoteId":9652,"paragraphs":[{"pid":417,"text":"Lit., “Be struggling.”"}]}],"25665":[{"footnoteId":9653,"paragraphs":[{"pid":418,"text":"That is, Herod Antipas, son of Herod the Great. See 3:1."}]}],"25666":[{"footnoteId":9654,"paragraphs":[{"pid":419,"text":"Lit., “I am being perfected.”"}]}],"25669":[{"footnoteId":9655,"paragraphs":[{"pid":420,"text":"See App 1D."}]}],"25684":[{"footnoteId":9656,"paragraphs":[{"pid":421,"text":"Or, “is at the feast.”"}]}],"25685":[{"footnoteId":9657,"paragraphs":[{"pid":422,"text":"Lit., “He.”"}]}],"25687":[{"footnoteId":9658,"paragraphs":[{"pid":423,"text":"Or, “Please let me be excused.”"}]}],"25695":[{"footnoteId":9659,"paragraphs":[{"pid":424,"text":"Or, “life.” See App 4A."}]}],"25696":[{"footnoteId":9660,"paragraphs":[{"pid":425,"text":"See App 5C."}]}],"25712":[{"footnoteId":9661,"paragraphs":[{"pid":426,"text":"A drachma was a Gr. silver coin that weighed 3.40 g (0.109 oz t)."}]}],"25722":[{"footnoteId":9662,"paragraphs":[{"pid":427,"text":"Or, “in your sight”; as in 1Sa 20:1 in LXX."}]}],"25725":[{"footnoteId":9663,"paragraphs":[{"pid":428,"text":"See vs 18 ftn."}]},{"footnoteId":9664,"paragraphs":[{"pid":429,"text":"“Make me as one of your hired men,” אBDSyh; P75AWVgSyp,s omit."}]}],"25727":[{"footnoteId":9665,"paragraphs":[{"pid":430,"text":"Or, “sacrifice.”"}]}],"25737":[{"footnoteId":9666,"paragraphs":[{"pid":431,"text":"Or, “a house manager.” Gr., oi·ko·noʹmon; J22(Heb.), soh·khen-baʹyith."}]}],"25742":[{"footnoteId":9667,"paragraphs":[{"pid":432,"text":"A bath equaled 22 L (5.81 gal)."}]}],"25743":[{"footnoteId":9668,"paragraphs":[{"pid":433,"text":"A cor equaled 220 L (200 dry qt)."}]}],"25744":[{"footnoteId":9669,"paragraphs":[{"pid":434,"text":"Or, “order of things.” Gr., ai·oʹnos; Lat., saeʹcu·li; J17,18,22(Heb.), ha·ʽoh·lamʹ, “the order of things.”"}]}],"25745":[{"footnoteId":9670,"paragraphs":[{"pid":435,"text":"Lit., “mammon of the unrighteousness.” Gr., ma·mo·naʹ tes a·di·kiʹas."}]},{"footnoteId":9671,"paragraphs":[{"pid":436,"text":"Lit., “everlasting tents.”"}]}],"25748":[{"footnoteId":9672,"paragraphs":[{"pid":437,"text":"Or, “what is your own,” P75אADWVgSyh,p,s; B, “what is our own.”"}]}],"25749":[{"footnoteId":9673,"paragraphs":[{"pid":438,"text":"Lit., “to mammon.” Gr., ma·mo·naiʹ; Lat., ma·moʹnae; J17,18,22(Heb.), ham·ma·mohnʹ, “the mammon.”"}]}],"25752":[{"footnoteId":9674,"paragraphs":[{"pid":439,"text":"“Is being declared as good news.” Gr., eu·ag·ge·liʹze·tai; Lat., e·van·ge·li·zaʹtur; J22(Heb.), mith·bas·seʹreth."}]}],"25754":[{"footnoteId":9675,"paragraphs":[{"pid":440,"text":"See Mt 5:32 ftn, “Adultery.”"}]},{"footnoteId":9676,"paragraphs":[{"pid":441,"text":"Lit., “loosed off.”"}]}],"25756":[{"footnoteId":9677,"paragraphs":[{"pid":442,"text":"Or, “poor man.”"}]},{"footnoteId":9678,"paragraphs":[{"pid":443,"text":"“Lazarus,” אAB; J18,22(Heb.), ʼEl·ʽa·zarʹ, “Eleazar,” meaning “God Has Helped.”"}]}],"25758":[{"footnoteId":9679,"paragraphs":[{"pid":444,"text":"“Bosom [position],” as when reclining in front of another on the same couch at a meal."}]}],"25759":[{"footnoteId":9680,"paragraphs":[{"pid":445,"text":"“Hades,” אAB; J6-8,10-18,22, “Sheol”; Lat., in·ferʹno. See App 4B."}]},{"footnoteId":9681,"paragraphs":[{"pid":446,"text":"“And was buried. And in Hades he,” AB; א*, “and was buried in Hades he”; Vg(Lat.), “and he was buried in in·ferʹno. But he.”"}]}],"25772":[{"footnoteId":9682,"paragraphs":[{"pid":447,"text":"Or, “Master.”"}]}],"25773":[{"footnoteId":9683,"paragraphs":[{"pid":448,"text":"Or, “this sycamine tree.”"}]}],"25783":[{"footnoteId":9684,"paragraphs":[{"pid":449,"text":"Lit., “his.”"}]}],"25786":[{"footnoteId":9685,"paragraphs":[{"pid":450,"text":"Or, “has saved you.”"}]}],"25788":[{"footnoteId":9686,"paragraphs":[{"pid":451,"text":"Or, “is among you.”"}]}],"25794":[{"footnoteId":9687,"paragraphs":[{"pid":452,"text":"Or, “deluge; cataclysm.” Gr., ka·ta·kly·smosʹ; Lat., di·luʹvi·um; J17,18,22(Heb.), ham·mab·bulʹ, “the deluge.”"}]}],"25800":[{"footnoteId":9688,"paragraphs":[{"pid":453,"text":"Or, “life.” Gr., psy·khenʹ; J17,18,22(Heb.), naph·shohʹ (from neʹphesh)."}]}],"25803":[{"footnoteId":9689,"paragraphs":[{"pid":454,"text":"P75אABW omit; DVgSyc,h,p,s, “Two men will be in the field; one will be taken along, and the other will be abandoned.”"}]}],"25804":[{"footnoteId":9690,"paragraphs":[{"pid":455,"text":"Or, “Master.”"}]}],"25809":[{"footnoteId":9691,"paragraphs":[{"pid":456,"text":"Or, “browbeating.” From a word meaning “to hit under the eye.”"}]}],"25812":[{"footnoteId":9692,"paragraphs":[{"pid":457,"text":"Or, “find this faith.”"}]}],"25819":[{"footnoteId":9693,"paragraphs":[{"pid":458,"text":"Or, “children.”"}]}],"25834":[{"footnoteId":9694,"paragraphs":[{"pid":459,"text":"Or, “order of things.” Gr., ai·oʹni; Lat., saeʹcu·lo; J22(Heb.), ba·ʽoh·lamʹ, “in the order of things.”"}]}],"25844":[{"footnoteId":9695,"paragraphs":[{"pid":460,"text":"Lit., “he.”"}]}],"25845":[{"footnoteId":9696,"paragraphs":[{"pid":461,"text":"Or, “Master.”"}]}],"25846":[{"footnoteId":9697,"paragraphs":[{"pid":462,"text":"Or, “has saved you.”"}]}],"25851":[{"footnoteId":9698,"paragraphs":[{"pid":463,"text":"Or, “sycamore tree.”"}]}],"25855":[{"footnoteId":9699,"paragraphs":[{"pid":464,"text":"Or, “Master.”"}]}],"25859":[{"footnoteId":9700,"paragraphs":[{"pid":465,"text":"Or, “secure a kingdom.”"}]}],"25860":[{"footnoteId":9701,"paragraphs":[{"pid":466,"text":"A Gr. mina weighed 340 g (10.9 oz t); not a coin, and different from the Heb. mina."}]}],"25862":[{"footnoteId":9702,"paragraphs":[{"pid":467,"text":"Or, “kingdom.” Gr., ba·si·leiʹan; Lat., reʹgno."}]}],"25863":[{"footnoteId":9703,"paragraphs":[{"pid":468,"text":"Or, “Master.”"}]}],"25867":[{"footnoteId":9704,"paragraphs":[{"pid":469,"text":"Or, “another one.” Sys, “the last one.”"}]}],"25885":[{"footnoteId":9705,"paragraphs":[{"pid":470,"text":"See App 1D."}]},{"footnoteId":9706,"paragraphs":[{"pid":471,"text":"Or, “in the heights above.”"}]}],"25899":[{"footnoteId":9707,"paragraphs":[{"pid":472,"text":"Or, “immersion; dipping.” Gr., baʹpti·sma."}]}],"25917":[{"footnoteId":9708,"paragraphs":[{"pid":473,"text":"Or, “to the emperor.” Gr., Kaiʹsa·ri; Lat., Caeʹsa·ri."}]}],"25919":[{"footnoteId":9709,"paragraphs":[{"pid":474,"text":"A Roman silver coin that weighed 3.85 g (0.124 oz t)."}]}],"25928":[{"footnoteId":9710,"paragraphs":[{"pid":475,"text":"“Resurrection.” Gr., a·na·staʹsei, “raising up; standing up” (from a·naʹ, “up,” and staʹsis, “standing”); Lat., re·sur·rec·ti·oʹne."}]}],"25929":[{"footnoteId":9711,"paragraphs":[{"pid":476,"text":"Or, “order of things.” Gr., ai·oʹnos; Lat., saeʹcu·li; J17,18,22(Heb.), ha·ʽoh·lamʹ, “the order of things.”"}]}],"25931":[{"footnoteId":9712,"paragraphs":[{"pid":477,"text":"“Children.” Or, “sons.”"}]}],"25932":[{"footnoteId":9713,"paragraphs":[{"pid":478,"text":"See App 1D."}]},{"footnoteId":9714,"paragraphs":[{"pid":479,"text":"Or, “when he says: ‘Jehovah the God of Abraham.’ ”"}]}],"25933":[{"footnoteId":9715,"paragraphs":[{"pid":480,"text":"Or, “living from his standpoint.”"}]}],"25937":[{"footnoteId":9716,"paragraphs":[{"pid":481,"text":"See App 1D."}]}],"25941":[{"footnoteId":9717,"paragraphs":[{"pid":482,"text":"See 11:43 ftn."}]}],"25943":[{"footnoteId":9718,"paragraphs":[{"pid":483,"text":"Or, “the sacred treasury.”"}]}],"25944":[{"footnoteId":9719,"paragraphs":[{"pid":484,"text":"Lit., “two lepta.” See App 8A."}]}],"25946":[{"footnoteId":9720,"paragraphs":[{"pid":485,"text":"Or, “contributed to the gifts.”"}]}],"25951":[{"footnoteId":9721,"paragraphs":[{"pid":486,"text":"Or, “accomplished end; completed end.” Gr., teʹlos."}]}],"25952":[{"footnoteId":9722,"paragraphs":[{"pid":487,"text":"Or, “be stirred up; be roused up.”"}]}],"25955":[{"footnoteId":9723,"paragraphs":[{"pid":488,"text":"“A witness.” Gr., mar·tyʹri·on; Lat., te·sti·moʹni·um."}]}],"25957":[{"footnoteId":9724,"paragraphs":[{"pid":489,"text":"Or, “forceful speech.”"}]}],"25961":[{"footnoteId":9725,"paragraphs":[{"pid":490,"text":"Or, “your [future] lives.” Gr., psy·khasʹ hy·monʹ; J17(Heb.), naph·sho·theh·khemʹ. See Mt 10:28."}]}],"25964":[{"footnoteId":9726,"paragraphs":[{"pid":491,"text":"Lit., “days of vengeance.”"}]}],"25965":[{"footnoteId":9727,"paragraphs":[{"pid":492,"text":"Or, “earth.”"}]}],"25966":[{"footnoteId":9728,"paragraphs":[{"pid":493,"text":"“Nations.” Gr., eth·nonʹ; Lat., genʹti·bus, “Gentiles”; J17(Heb.), ghoh·yimʹ, “goyim.”"}]},{"footnoteId":9729,"paragraphs":[{"pid":494,"text":"“Are fulfilled and will be,” B."}]}],"25968":[{"footnoteId":9730,"paragraphs":[{"pid":495,"text":"Lit., “the inhabited.” Gr., tei oi·kou·meʹnei, dative, fem. sing., referring to the earth; Lat., u·ni·verʹso orʹbi, “the whole circle,” that is, of the earth. See Isa 13:11 ftn, “Land”; Na 1:5 ftn."}]},{"footnoteId":9731,"paragraphs":[{"pid":496,"text":"Or, “forces; hosts.”"}]}],"25969":[{"footnoteId":9732,"paragraphs":[{"pid":497,"text":"“Coming.” Gr., er·khoʹme·non."}]}],"25974":[{"footnoteId":9733,"paragraphs":[{"pid":498,"text":"“Generation.” Gr., ge·ne·aʹ; different from geʹnos, “race,” as in 1Pe 2:9."}]}],"25976":[{"footnoteId":9734,"paragraphs":[{"pid":499,"text":"Or, “anxieties over livelihood.”"}]}],"25999":[{"footnoteId":9735,"paragraphs":[{"pid":500,"text":"Or, “is,” in the sense of signifying, importing, representing. See Mt 26:26 ftn."}]}],"26000":[{"footnoteId":9736,"paragraphs":[{"pid":501,"text":"“Which is to be given . . . poured out in your behalf,” P75אABWVgSyh,pArm; DIt omit these words of vss 19, 20."}]}],"26006":[{"footnoteId":9737,"paragraphs":[{"pid":502,"text":"Or, “serving.”"}]}],"26013":[{"footnoteId":9738,"paragraphs":[{"pid":503,"text":"Or, “Master.”"}]}],"26015":[{"footnoteId":9739,"paragraphs":[{"pid":504,"text":"Lit., “For nothing!”"}]}],"26018":[{"footnoteId":9740,"paragraphs":[{"pid":505,"text":"Or, “Master.”"}]}],"26024":[{"footnoteId":9741,"paragraphs":[{"pid":506,"text":"Vss 43, 44 are contained in א*DVgSyc,h,hi,pArm; P75אcABWSys omit."}]}],"26037":[{"footnoteId":9742,"paragraphs":[{"pid":507,"text":"“Him,” AD*VgSyh."}]}],"26043":[{"footnoteId":9743,"paragraphs":[{"pid":508,"text":"“Him,” אBDItVg; ASyp, “Jesus.”"}]}],"26046":[{"footnoteId":9744,"paragraphs":[{"pid":509,"text":"Or, “their Sanhedrin.”"}]}],"26049":[{"footnoteId":9745,"paragraphs":[{"pid":510,"text":"Or, “at the right hand of the power.”"}]}],"26053":[{"footnoteId":9746,"paragraphs":[{"pid":511,"text":"Or, “the emperor.” Gr., Kaiʹsa·ri; Lat., Caeʹsa·ri."}]}],"26058":[{"footnoteId":9747,"paragraphs":[{"pid":512,"text":"That is, Herod Antipas, son of Herod the Great. See 3:1."}]}],"26062":[{"footnoteId":9748,"paragraphs":[{"pid":513,"text":"Or, “splendid.”"}]}],"26068":[{"footnoteId":9749,"paragraphs":[{"pid":514,"text":"P75AB omit vs 17; אWVgSyp, “Now he was under necessity to release one man to them from feast to feast.” (DSyc,s add these words after vs 19.)"}]}],"26072":[{"footnoteId":9750,"paragraphs":[{"pid":515,"text":"Or, “Fasten him on a stake (pole)!” See App 5C."}]}],"26084":[{"footnoteId":9751,"paragraphs":[{"pid":516,"text":"“Skull.” Gr., Kra·niʹon; Lat., Cal·vaʹri·ae; J17,18(Heb.), Gul·gol·taʼʹ. See Mt 27:33."}]}],"26085":[{"footnoteId":9752,"paragraphs":[{"pid":517,"text":"אCVgSyc,p insert these bracketed words; P75BD*WSys omit."}]}],"26089":[{"footnoteId":9753,"paragraphs":[{"pid":518,"text":"According to P75BSyc,s; DVgSyp add: “(written) in letters of Greek and Latin and Hebrew,” to agree with Joh 19:20."}]},{"footnoteId":9754,"paragraphs":[{"pid":519,"text":"Lit., “The king of the Jews this (one).” Gr., Ho ba·si·leusʹ ton I·ou·daiʹon houʹtos; Lat., hic est rex Iu·dae·oʹrum; J22(Heb.), zeʹhuʼ meʹlekh hai·Yehu·dhimʹ."}]}],"26094":[{"footnoteId":9755,"paragraphs":[{"pid":520,"text":"“Today.” Although WH puts a comma in the Gr. text before the word for “today,” commas were not used in Gr. uncial mss. In keeping with the context, we omit the comma before “today.” Syc (fifth cent. C.E.) renders this text: “Amen, I say to thee to-day that with me thou shalt be in the Garden of Eden.”—⁠F. C. Burkitt, The Curetonian Version of the Four Gospels, Vol. I, Cambridge, 1904."}]},{"footnoteId":9756,"paragraphs":[{"pid":521,"text":"“In Paradise,” אABVgJ11,13,16; Gr., en toi pa·ra·deiʹsoi; J17,18,22(Heb.), beghan-ʽEʹdhen, “in the garden of Eden.” See Ge 2:8, 10, 15, 16, in LXX."}]}],"26095":[{"footnoteId":9757,"paragraphs":[{"pid":522,"text":"“Ninth hour” would be about 3 p.m. The “sixth hour” would be about 12 noon, counting from sunrise."}]}],"26096":[{"footnoteId":9758,"paragraphs":[{"pid":523,"text":"Or, “the divine habitation (dwelling).” Gr., tou na·ouʹ; Lat., temʹpli; J17,18,22(Heb.), ha·heh·khalʹ."}]}],"26098":[{"footnoteId":9759,"paragraphs":[{"pid":524,"text":"Or, “centurion”; a commander of 100 soldiers."}]}],"26101":[{"footnoteId":9760,"paragraphs":[{"pid":525,"text":"Or, “a counselor; a senator.” Gr., bou·leu·tesʹ."}]}],"26102":[{"footnoteId":9761,"paragraphs":[{"pid":526,"text":"Or, “Jews.” Gr., I·ou·daiʹon."}]}],"26105":[{"footnoteId":9762,"paragraphs":[{"pid":527,"text":"Or, “and sabbath was drawing on.”"}]}],"26110":[{"footnoteId":9763,"paragraphs":[{"pid":528,"text":"“Of the Lord Jesus,” P75אABCWVgSyArm; DItmss omit."}]}],"26113":[{"footnoteId":9764,"paragraphs":[{"pid":529,"text":"“He is not here, but has been raised up,” P75אABVgSyArm; DItmss omit."}]}],"26114":[{"footnoteId":9765,"paragraphs":[{"pid":530,"text":"Or, “fastened on a stake (pole).” See App 5C."}]}],"26116":[{"footnoteId":9766,"paragraphs":[{"pid":531,"text":"“From the memorial tomb,” P75אABWVgSy; DItmssArm omit."}]}],"26119":[{"footnoteId":9767,"paragraphs":[{"pid":532,"text":"According to P75אABWVgSy; DItmss omit these bracketed words."}]}],"26120":[{"footnoteId":9768,"paragraphs":[{"pid":533,"text":"Or, “seven and a half [Roman] miles.” Lit., “sixty stadia.” Gr., sta·diʹous he·xeʹkon·ta; Lat., sta·di·oʹrum se·xa·ginʹta; about 11 km. Mt 5:41 ftn; see App 8A."}]}],"26139":[{"footnoteId":9769,"paragraphs":[{"pid":534,"text":"“Burning,” אAB; D, “veiled”; Syp,s, “heavy”; Itms l, “dull”; Itms c, “blinded.”"}]}],"26141":[{"footnoteId":9770,"paragraphs":[{"pid":535,"text":"Or, “Master.”"}]}],"26143":[{"footnoteId":9771,"paragraphs":[{"pid":536,"text":"“And said . . . peace,” P75אAB; DIt omit."}]}],"26147":[{"footnoteId":9772,"paragraphs":[{"pid":537,"text":"According to P75אABWVgSyh,hi,pArm (compare Joh 20:20); DItSyc,s omit vs 40."}]}],"26149":[{"footnoteId":9773,"paragraphs":[{"pid":538,"text":"VgSyc,p and mss ENXΔΘ (sixth to tenth cent.) add, “and a honeycomb”; P75אABDSys omit."}]}],"26158":[{"footnoteId":9774,"paragraphs":[{"pid":539,"text":"“And began to be borne up to heaven,” P75אcABCWVgSypArm; א*DSys omit."}]}],"26159":[{"footnoteId":9775,"paragraphs":[{"pid":540,"text":"“Did obeisance to him and,” P75אABCWSyh,p; DItmssSys omit. Compare Heb 1:6."}]}]}