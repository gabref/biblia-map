{"29175":[{"footnoteId":10643,"paragraphs":[{"pid":42,"text":"The Roman province that occupied the central portion of what is now known as Asia Minor."}]}],"29177":[{"footnoteId":10644,"paragraphs":[{"pid":43,"text":"Or, “order of things.” Gr., ai·oʹnos; Lat., saeʹcu·lo; J17,18,22(Heb.), ha·ʽoh·lamʹ, “the order of things.”"}]}],"29181":[{"footnoteId":10645,"paragraphs":[{"pid":44,"text":"Lit., “anathema,” that is, one devoted to destruction or accursed. See De 7:26 and De 13:17 ftns."}]}],"29185":[{"footnoteId":10646,"paragraphs":[{"pid":45,"text":"Lit., “uncovering; disclosure.” Gr., a·po·ka·lyʹpse·os."}]}],"29188":[{"footnoteId":10647,"paragraphs":[{"pid":46,"text":"Lit., “having defined me off out of the cavity of my mother.”"}]}],"29191":[{"footnoteId":10648,"paragraphs":[{"pid":47,"text":"Lit., “to visit for inquiry.”"}]}],"29199":[{"footnoteId":10649,"paragraphs":[{"pid":48,"text":"Or, “I am heralding.” Gr., ke·rysʹso; Lat., praeʹdi·co. Compare Da 5:29 ftn, “Heralded.”"}]}],"29203":[{"footnoteId":10650,"paragraphs":[{"pid":49,"text":"“God,” P46אABCD; J7,8, “Jehovah.”"}]}],"29204":[{"footnoteId":10651,"paragraphs":[{"pid":50,"text":"Lit., “of the uncircumcision.”"}]},{"footnoteId":10652,"paragraphs":[{"pid":51,"text":"Lit., “of the circumcision.”"}]}],"29208":[{"footnoteId":10653,"paragraphs":[{"pid":52,"text":"Lit., “I stood against.”"}]}],"29209":[{"footnoteId":10654,"paragraphs":[{"pid":53,"text":"Lit., “the (ones) out of circumcision.”"}]}],"29210":[{"footnoteId":10655,"paragraphs":[{"pid":54,"text":"Lit., “hypocrisy.” Gr., hy·po·kriʹsei."}]}],"29213":[{"footnoteId":10656,"paragraphs":[{"pid":55,"text":"Lit., “is being justified.” Gr., di·kai·ouʹtai."}]}],"29217":[{"footnoteId":10657,"paragraphs":[{"pid":56,"text":"Or, “fastened on a stake (pole).” See App 5C."}]}],"29220":[{"footnoteId":10658,"paragraphs":[{"pid":57,"text":"Or, “due to a report of faith.”"}]}],"29223":[{"footnoteId":10659,"paragraphs":[{"pid":58,"text":"Or, “performs miracles.”"}]}],"29224":[{"footnoteId":10660,"paragraphs":[{"pid":59,"text":"See App 1D."}]}],"29227":[{"footnoteId":10661,"paragraphs":[{"pid":60,"text":"Or, “believing.”"}]}],"29231":[{"footnoteId":10662,"paragraphs":[{"pid":61,"text":"Or, “tree.” Gr., xyʹlou. See App 5C."}]}],"29232":[{"footnoteId":10663,"paragraphs":[{"pid":62,"text":"Lit., “the promise of the spirit.”"}]}],"29234":[{"footnoteId":10664,"paragraphs":[{"pid":63,"text":"Or, “He.”"}]}],"29237":[{"footnoteId":10665,"paragraphs":[{"pid":64,"text":"Or, “added in favor of the transgressions.”"}]}],"29238":[{"footnoteId":10666,"paragraphs":[{"pid":65,"text":"“God,” P46אABVgSyp; J7,8, “Jehovah.”"}]}],"29239":[{"footnoteId":10667,"paragraphs":[{"pid":66,"text":"“Of God,” אACDItVgSyh,pArm; P46B omit."}]}],"29242":[{"footnoteId":10668,"paragraphs":[{"pid":67,"text":"Lit., “pedagogue.” Gr., pai·da·go·gosʹ; Lat., pe·da·goʹgus."}]}],"29245":[{"footnoteId":10669,"paragraphs":[{"pid":68,"text":"Or, “have clothed (identified) yourselves with Christ.”"}]}],"29249":[{"footnoteId":10670,"paragraphs":[{"pid":69,"text":"Or, “house managers.”"}]}],"29253":[{"footnoteId":10671,"paragraphs":[{"pid":70,"text":"“Abba,” an Aram. word meaning “the father,” or, “O Father!”"}]}],"29257":[{"footnoteId":10672,"paragraphs":[{"pid":71,"text":"Or, “appointed times.” Gr., kai·rousʹ."}]}],"29261":[{"footnoteId":10673,"paragraphs":[{"pid":72,"text":"Or, “temptation.” Lit., “testing.”"}]}],"29267":[{"footnoteId":10674,"paragraphs":[{"pid":73,"text":"Lit., “and to alter my voice.”"}]}],"29271":[{"footnoteId":10675,"paragraphs":[{"pid":74,"text":"Or, “as an allegory.” Gr., al·le·go·rouʹme·na; Lat., per al·le·goʹri·am."}]}],"29279":[{"footnoteId":10676,"paragraphs":[{"pid":75,"text":"Or, “With her freedom.” Gr., Tei e·leu·the·riʹai."}]}],"29283":[{"footnoteId":10677,"paragraphs":[{"pid":76,"text":"Lit., “hope of righteousness.”"}]}],"29284":[{"footnoteId":10678,"paragraphs":[{"pid":77,"text":"“Jesus.” B omits."}]}],"29288":[{"footnoteId":10679,"paragraphs":[{"pid":78,"text":"“I am confident in Jehovah concerning you,” J7,8."}]}],"29289":[{"footnoteId":10680,"paragraphs":[{"pid":79,"text":"Or, “the offense.” Lit., “the fall-causer.” Gr., to skanʹda·lon; Lat., scanʹda·lum."}]},{"footnoteId":10681,"paragraphs":[{"pid":80,"text":"See App 5C."}]}],"29290":[{"footnoteId":10682,"paragraphs":[{"pid":81,"text":"“Would even get themselves emasculated,” P46אABD; J7,8, “would even be cut off from before the eyes of Jehovah.”"}]}],"29292":[{"footnoteId":10683,"paragraphs":[{"pid":82,"text":"Or, “shall.”"}]}],"29297":[{"footnoteId":10684,"paragraphs":[{"pid":83,"text":"See App 5A."}]},{"footnoteId":10685,"paragraphs":[{"pid":84,"text":"Or, “filthiness; depravity; lewdness.” Gr., a·ka·thar·siʹa; J17,22(Heb.), tum·ʼahʹ. See Eze 22:15 ftn, “Uncleanness.”"}]},{"footnoteId":10686,"paragraphs":[{"pid":85,"text":"Or, “licentiousness; wantonness; shameless conduct.” Gr., a·selʹgei·a; Vgc(Lat.), im·pu·di·ciʹti·a; J18,22(Heb.), zim·mahʹ. See Pr 10:23 ftn, “Conduct.”"}]}],"29298":[{"footnoteId":10687,"paragraphs":[{"pid":86,"text":"Or, “druggery.” Gr., phar·ma·kiʹa. See Re 21:8 ftn, “Spiritism.”"}]},{"footnoteId":10688,"paragraphs":[{"pid":87,"text":"“Sects.” Gr., hai·reʹseis; Lat., secʹtae."}]}],"29302":[{"footnoteId":10689,"paragraphs":[{"pid":88,"text":"Or, “fastened on a stake (pole).” See App 5C."}]}],"29304":[{"footnoteId":10690,"paragraphs":[{"pid":89,"text":"Or, “forcing one another to a showdown.”"}]}],"29305":[{"footnoteId":10691,"paragraphs":[{"pid":90,"text":"Lit., “should be overtaken.”"}]},{"footnoteId":10692,"paragraphs":[{"pid":91,"text":"Or, “to restore to proper position; to bring into proper alignment.”"}]}],"29306":[{"footnoteId":10693,"paragraphs":[{"pid":92,"text":"Or, “troublesome things.” Lit., “heavy things.” Gr., baʹre."}]}],"29308":[{"footnoteId":10694,"paragraphs":[{"pid":93,"text":"“Each one,” אACDVg; P46B, “him.”"}]}],"29309":[{"footnoteId":10695,"paragraphs":[{"pid":94,"text":"“Load.” Gr., phor·tiʹon. Compare vs 2."}]}],"29310":[{"footnoteId":10696,"paragraphs":[{"pid":95,"text":"Lit., “being sounded down to.” Gr., ka·te·khouʹme·nos; Lat., ca·te·ci·zaʹtur."}]}],"29315":[{"footnoteId":10697,"paragraphs":[{"pid":96,"text":"Or, “You see.”"}]},{"footnoteId":10698,"paragraphs":[{"pid":97,"text":"Or, “with what a long letter.”"}]}],"29316":[{"footnoteId":10699,"paragraphs":[{"pid":98,"text":"See App 5C."}]},{"footnoteId":10700,"paragraphs":[{"pid":99,"text":"“Christ, Jesus,” P46B; אACDVgSyp, “Christ.”"}]}],"29320":[{"footnoteId":10701,"paragraphs":[{"pid":100,"text":"“By . . . rule of conduct.” Or, “by . . . canon (rule).” Lit., “to the (measuring) reed.” Gr., toi ka·noʹni; Lat., reʹgu·lam, “regulation”; J18(Heb.), qenehʹ ham·mid·dahʹ, “the reed of measure.” Compare Eze 40:5 ftn, “Reed.”"}]},{"footnoteId":10702,"paragraphs":[{"pid":101,"text":"Meaning “God Contends; Contender (Perseverer) With God.”"}]}],"29321":[{"footnoteId":10703,"paragraphs":[{"pid":102,"text":"Or, “Finally.”"}]}],"29322":[{"footnoteId":10704,"paragraphs":[{"pid":103,"text":"“Our,” P46ABCDVgSyp; א, “the.”"}]}]}