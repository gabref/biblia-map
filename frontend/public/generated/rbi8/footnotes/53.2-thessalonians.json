{"29766":[{"footnoteId":10914,"paragraphs":[{"pid":18,"text":"Or, “Silas.”"}]}],"29771":[{"footnoteId":10915,"paragraphs":[{"pid":19,"text":"Lit., “to give back instead.”"}]}],"29772":[{"footnoteId":10916,"paragraphs":[{"pid":20,"text":"Or, “uncovering; disclosure.” Gr., a·po·ka·lyʹpsei."}]}],"29773":[{"footnoteId":10917,"paragraphs":[{"pid":21,"text":"“Vengeance.” Gr., ek·diʹke·sin; Lat., vin·dicʹtam."}]}],"29775":[{"footnoteId":10918,"paragraphs":[{"pid":22,"text":"“Witness.” Gr., mar·tyʹri·on; Lat., te·sti·moʹni·um."}]}],"29777":[{"footnoteId":10919,"paragraphs":[{"pid":23,"text":"See App 6E."}]}],"29778":[{"footnoteId":10920,"paragraphs":[{"pid":24,"text":"See App 5B."}]},{"footnoteId":10921,"paragraphs":[{"pid":25,"text":"“Our,” אADVgSyp; B, “the.”"}]}],"29779":[{"footnoteId":10922,"paragraphs":[{"pid":26,"text":"Or, “through a spirit.”"}]},{"footnoteId":10923,"paragraphs":[{"pid":27,"text":"See App 1D."}]}],"29780":[{"footnoteId":10924,"paragraphs":[{"pid":28,"text":"“Apostasy.” Gr., a·po·sta·siʹa. This noun comes from the verb a·phiʹste·mi, “stand away from.” The noun has the sense of “desertion; abandonment; rebellion.” See Ac 21:21 ftn."}]},{"footnoteId":10925,"paragraphs":[{"pid":29,"text":"“Lawlessness,” אB; ADVgSyp, “sin.”"}]},{"footnoteId":10926,"paragraphs":[{"pid":30,"text":"Or, “of annihilation.” See Mt 7:13 ftn."}]}],"29781":[{"footnoteId":10927,"paragraphs":[{"pid":31,"text":"Or, “divine habitation (dwelling).” Gr., na·onʹ; Lat., temʹplo; J17,18,22(Heb.), beheh·khalʹ, “in the palace (temple) of.”"}]},{"footnoteId":10928,"paragraphs":[{"pid":32,"text":"“The God.” Gr., tou The·ouʹ; J17,22(Heb.), ha·ʼElo·himʹ, “the [true] God.” See Ge 5:22 ftn, “God.”"}]}],"29784":[{"footnoteId":10929,"paragraphs":[{"pid":33,"text":"Lit., “the (one) holding down right now.”"}]}],"29785":[{"footnoteId":10930,"paragraphs":[{"pid":34,"text":"“Jesus,” אAD*Vg; BDc omit."}]}],"29786":[{"footnoteId":10931,"paragraphs":[{"pid":35,"text":"Or, “whose presence,” referring to “whom” in vs 8. See App 5B."}]},{"footnoteId":10932,"paragraphs":[{"pid":36,"text":"Lit., “working within.”"}]}],"29787":[{"footnoteId":10933,"paragraphs":[{"pid":37,"text":"Lit., “seduction.”"}]}],"29789":[{"footnoteId":10934,"paragraphs":[{"pid":38,"text":"Lit., “having thought well.”"}]}],"29790":[{"footnoteId":10935,"paragraphs":[{"pid":39,"text":"“Jehovah,” J13,16,24; אAB(Gr.), Ky·riʹou; D*Vg, “God.” See App 1D."}]}],"29795":[{"footnoteId":10936,"paragraphs":[{"pid":40,"text":"See App 1D."}]}],"29800":[{"footnoteId":10937,"paragraphs":[{"pid":41,"text":"Or, “instruction.”"}]}],"29808":[{"footnoteId":10938,"paragraphs":[{"pid":42,"text":"Lit., “be you putting sign on.”"}]},{"footnoteId":10939,"paragraphs":[{"pid":43,"text":"Lit., “not to mix up selves with.”"}]}],"29809":[{"footnoteId":10940,"paragraphs":[{"pid":44,"text":"Lit., “be you putting mind in.”"}]}]}