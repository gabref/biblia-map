{"30055":[{"footnoteId":11075,"paragraphs":[{"pid":11,"text":"Or, “a prisoner of Christ Jesus.”"}]},{"footnoteId":11076,"paragraphs":[{"pid":12,"text":"“To Philemon.” Gr., Phi·leʹmo·ni, meaning “Loving.”"}]}],"30060":[{"footnoteId":11077,"paragraphs":[{"pid":13,"text":"“May go into action.” Lit., “might become operative within.”"}]},{"footnoteId":11078,"paragraphs":[{"pid":14,"text":"“By your acknowledging.” Lit., “in accurate knowledge.”"}]}],"30061":[{"footnoteId":11079,"paragraphs":[{"pid":15,"text":"“The tender affections.” Lit., “the bowels.”"}]}],"30062":[{"footnoteId":11080,"paragraphs":[{"pid":16,"text":"Lit., “outspokenness.”"}]}],"30063":[{"footnoteId":11081,"paragraphs":[{"pid":17,"text":"Lit., “I am encouraging.”"}]},{"footnoteId":11082,"paragraphs":[{"pid":18,"text":"Or, “an ambassador.”"}]}],"30064":[{"footnoteId":11083,"paragraphs":[{"pid":19,"text":"“Onesimus,” meaning “Profitable.”"}]}],"30066":[{"footnoteId":11084,"paragraphs":[{"pid":20,"text":"See vs 7 ftn."}]}],"30067":[{"footnoteId":11085,"paragraphs":[{"pid":21,"text":"Lit., “he may serve.”"}]},{"footnoteId":11086,"paragraphs":[{"pid":22,"text":"Or, “in the bonds of the good news.”"}]}],"30068":[{"footnoteId":11087,"paragraphs":[{"pid":23,"text":"Lit., “necessity.”"}]},{"footnoteId":11088,"paragraphs":[{"pid":24,"text":"Lit., “but according to what is voluntary.”"}]}],"30072":[{"footnoteId":11089,"paragraphs":[{"pid":25,"text":"Lit., “to me be you setting to account.”"}]}],"30075":[{"footnoteId":11090,"paragraphs":[{"pid":26,"text":"Lit., “obedience.”"}]}],"30079":[{"footnoteId":11091,"paragraphs":[{"pid":27,"text":"Lit., “with your spirit.”"}]}]}