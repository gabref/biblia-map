."}]},{"footnoteId":11271,"paragraphs":[{"pid":263,"text":"Or, “tabernacle.”"}]},{"footnoteId":11272,"paragraphs":[{"pid":264,"text":"“Authority.” D* omits."}]}],"30368":[{"footnoteId":11273,"paragraphs":[{"pid":265,"text":"Or, “places.”"}]}],"30370":[{"footnoteId":11274,"paragraphs":[{"pid":266,"text":"Or, “reproach for him; his reproach.”"}]}],"30372":[{"footnoteId":11275,"paragraphs":[{"pid":267,"text":"Lit., “confessing.”"}]}],"30374":[{"footnoteId":11276,"paragraphs":[{"pid":268,"text":"Or, “are governors of you.” Gr., he·gou·meʹnois hy·monʹ. See Mt 2:6 ftn, “Governors.”"}]},{"footnoteId":11277,"paragraphs":[{"pid":269,"text":"Lit., “be you yielding under.”"}]}],"30380":[{"footnoteId":11278,"paragraphs":[{"pid":270,"text":"Or, “comes more quickly [than I expected].”"}]}],"30381":[{"footnoteId":11279,"paragraphs":[{"pid":271,"text":"See vs 17 ftn, “You.”"}]},{"footnoteId":11280,"paragraphs":[{"pid":272,"text":"Or, “of.”"}]}],"30382":[{"footnoteId":11281,"paragraphs":[{"pid":273,"text":"ACDItVgSyh,p add “Amen”; P46אArm omit."}]}]}