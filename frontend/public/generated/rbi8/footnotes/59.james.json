{"30383":[{"footnoteId":11282,"paragraphs":[{"pid":36,"text":"Lit., “Jacob.” Gr., I·aʹko·bos. “James” is an abbreviated English form of Jacob, meaning “Taking Hold of the Heel; Supplanter.”"}]},{"footnoteId":11283,"paragraphs":[{"pid":37,"text":"“That are scattered about.” Lit., “the (ones) in the dispersion [Gr., di·a·spo·raiʹ; Lat., di·sper·si·oʹne].”"}]}],"30385":[{"footnoteId":11284,"paragraphs":[{"pid":38,"text":"Or, “this way of testing.”"}]}],"30388":[{"footnoteId":11285,"paragraphs":[{"pid":39,"text":"Lit., “judging for self dividedly.”"}]}],"30389":[{"footnoteId":11286,"paragraphs":[{"pid":40,"text":"See App 1D."}]}],"30390":[{"footnoteId":11287,"paragraphs":[{"pid":41,"text":"Lit., “two-souled.” Gr., diʹpsy·khos; Lat., duʹplex aʹni·mo."}]}],"30394":[{"footnoteId":11288,"paragraphs":[{"pid":42,"text":"“Jehovah,” J7,8,13,16,17; C(Gr.), Kyʹri·os; ItVgSyp, “God”; אAB omit. See App 1D."}]}],"30396":[{"footnoteId":11289,"paragraphs":[{"pid":43,"text":"Or, “caught as by bait.” Lit., “being baited on.”"}]}],"30399":[{"footnoteId":11290,"paragraphs":[{"pid":44,"text":"Or, “variation or shadow caused by a turning.”"}]}],"30403":[{"footnoteId":11291,"paragraphs":[{"pid":45,"text":"Or, “your lives.” Gr., tas psy·khasʹ hy·monʹ; Lat., aʹni·mas veʹstras; J17(Heb.), naph·sho·theh·khemʹ."}]}],"30407":[{"footnoteId":11292,"paragraphs":[{"pid":46,"text":"Lit., “having stooped beside.”"}]}],"30408":[{"footnoteId":11293,"paragraphs":[{"pid":47,"text":"Or, “thinks himself.”"}]},{"footnoteId":11294,"paragraphs":[{"pid":48,"text":"“Formal worshiper.” Lat., re·li·gi·oʹsum, “religious.”"}]}],"30409":[{"footnoteId":11295,"paragraphs":[{"pid":49,"text":"“Form of worship.” Gr., thre·skeiʹa; Lat., re·liʹgi·o, “religion.”"}]},{"footnoteId":11296,"paragraphs":[{"pid":50,"text":"Or, “bereaved ones.”"}]}],"30410":[{"footnoteId":11297,"paragraphs":[{"pid":51,"text":"Or, “My brothers, stop holding . . . of favoritism.”"}]}],"30411":[{"footnoteId":11298,"paragraphs":[{"pid":52,"text":"“Gathering.” Gr., sy·na·go·genʹ."}]}],"30415":[{"footnoteId":11299,"paragraphs":[{"pid":53,"text":"Lit., “judgment places.”"}]}],"30419":[{"footnoteId":11300,"paragraphs":[{"pid":54,"text":"Lit., “he might trip.”"}]}],"30421":[{"footnoteId":11301,"paragraphs":[{"pid":55,"text":"Or, “law that belongs to freedom.”"}]}],"30422":[{"footnoteId":11302,"paragraphs":[{"pid":56,"text":"Or, “as superior to.”"}]}],"30428":[{"footnoteId":11303,"paragraphs":[{"pid":57,"text":"Lit., “they are bristling up.”"}]}],"30432":[{"footnoteId":11304,"paragraphs":[{"pid":58,"text":"See App 1D."}]},{"footnoteId":11305,"paragraphs":[{"pid":59,"text":"See App 1D."}]}],"30435":[{"footnoteId":11306,"paragraphs":[{"pid":60,"text":"Or, “breath.”"}]}],"30441":[{"footnoteId":11307,"paragraphs":[{"pid":61,"text":"See App 4C."}]}],"30444":[{"footnoteId":11308,"paragraphs":[{"pid":62,"text":"“Jehovah,” J18,23; אABC(Gr.), ton Kyʹri·on; VgcSyh, “God.” See App 1D."}]}],"30449":[{"footnoteId":11309,"paragraphs":[{"pid":63,"text":"Lit., “not be you boasting down.”"}]}],"30450":[{"footnoteId":11310,"paragraphs":[{"pid":64,"text":"Lit., “soulical.” Gr., psy·khi·keʹ; Lat., a·ni·maʹlis. See 1Co 2:14 and 1Co 15:44 ftns."}]}],"30451":[{"footnoteId":11311,"paragraphs":[{"pid":65,"text":"Lit., “unsettled state.”"}]}],"30452":[{"footnoteId":11312,"paragraphs":[{"pid":66,"text":"Lit., “yielding.”"}]}],"30453":[{"footnoteId":11313,"paragraphs":[{"pid":67,"text":"Or, “sown with peace.”"}]},{"footnoteId":11314,"paragraphs":[{"pid":68,"text":"Or, “by.”"}]}],"30455":[{"footnoteId":11315,"paragraphs":[{"pid":69,"text":"Or, “and are jealous.”"}]}],"30457":[{"footnoteId":11316,"paragraphs":[{"pid":70,"text":"“Adulteresses.” Lat., a·dulʹte·ri."}]}],"30460":[{"footnoteId":11317,"paragraphs":[{"pid":71,"text":"Lit., “stand you against.”"}]}],"30461":[{"footnoteId":11318,"paragraphs":[{"pid":72,"text":"Lit., “two-souled.”"}]}],"30463":[{"footnoteId":11319,"paragraphs":[{"pid":73,"text":"See App 1D."}]}],"30468":[{"footnoteId":11320,"p