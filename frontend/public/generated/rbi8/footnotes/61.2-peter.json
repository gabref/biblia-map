{"30596":[{"footnoteId":11408,"paragraphs":[{"pid":21,"text":"“Our God,” ABVg; אSyh, “our Lord.”"}]},{"footnoteId":11409,"paragraphs":[{"pid":22,"text":"“Of our God and [the] Savior Jesus Christ,” in agreement with the distinction between God and Jesus in the next vs. See App 6E."}]}],"30597":[{"footnoteId":11410,"paragraphs":[{"pid":23,"text":"See App 6E."}]}],"30598":[{"footnoteId":11411,"paragraphs":[{"pid":24,"text":"“His divine power,” אAB; J18, “Jehovah by his power.”"}]}],"30599":[{"footnoteId":11412,"paragraphs":[{"pid":25,"text":"“In divine nature.” Gr., theiʹas . . . phyʹse·os."}]}],"30603":[{"footnoteId":11413,"paragraphs":[{"pid":26,"text":"Or, “cause you to be neither inactive nor unfruitful.”"}]}],"30604":[{"footnoteId":11414,"paragraphs":[{"pid":27,"text":"Or, “blind, seeing only what is near.”"}]}],"30609":[{"footnoteId":11415,"paragraphs":[{"pid":28,"text":"Or, “is coming swiftly.”"}]}],"30610":[{"footnoteId":11416,"paragraphs":[{"pid":29,"text":"Or, “to call these things to remembrance.”"}]}],"30611":[{"footnoteId":11417,"paragraphs":[{"pid":30,"text":"See App 5B."}]}],"30612":[{"footnoteId":11418,"paragraphs":[{"pid":31,"text":"“Words such as these.” Lit., “such a voice.”"}]},{"footnoteId":11419,"paragraphs":[{"pid":32,"text":"Lit., “thought well.”"}]}],"30613":[{"footnoteId":11420,"paragraphs":[{"pid":33,"text":"Lit., “this voice.”"}]}],"30614":[{"footnoteId":11421,"paragraphs":[{"pid":34,"text":"Lit., “light bearer.”"}]}],"30615":[{"footnoteId":11422,"paragraphs":[{"pid":35,"text":"Or, “comes out of private disclosure [or, release].”"}]}],"30617":[{"footnoteId":11423,"paragraphs":[{"pid":36,"text":"Or, “heresies.” Gr., hai·reʹseis; Lat., secʹtas."}]}],"30618":[{"footnoteId":11424,"paragraphs":[{"pid":37,"text":"“Acts of loose conduct.” Gr., a·sel·geiʹais. See Ga 5:19 ftn, “Conduct.”"}]}],"30620":[{"footnoteId":11425,"paragraphs":[{"pid":38,"text":"For a discussion of “Tartarus,” see App 4D."}]}],"30621":[{"footnoteId":11426,"paragraphs":[{"pid":39,"text":"Lit., “archaic.” Gr., ar·khaiʹou."}]},{"footnoteId":11427,"paragraphs":[{"pid":40,"text":"Or, “flood; cataclysm.” Gr., ka·ta·kly·smonʹ; Lat., di·luʹvi·um."}]}],"30622":[{"footnoteId":11428,"paragraphs":[{"pid":41,"text":"Lit., “irreverential (ones).”"}]}],"30623":[{"footnoteId":11429,"paragraphs":[{"pid":42,"text":"“Loose conduct.” Lit., “lewdness of conduct.”"}]}],"30625":[{"footnoteId":11430,"paragraphs":[{"pid":43,"text":"See App 1D."}]},{"footnoteId":11431,"paragraphs":[{"pid":44,"text":"Or, “be checked.” Compare Mt 25:46."}]}],"30626":[{"footnoteId":11432,"paragraphs":[{"pid":45,"text":"Lit., “minding down.”"}]},{"footnoteId":11433,"paragraphs":[{"pid":46,"text":"Lit., “at glories.”"}]}],"30627":[{"footnoteId":11434,"paragraphs":[{"pid":47,"text":"“For Jehovah,” J7,8,13,16-18,22-24; אBC(Gr.), Ky·riʹoi; AVgSyh omit. See App 1D."}]}],"30629":[{"footnoteId":11435,"paragraphs":[{"pid":48,"text":"Or, “in their dissipations.”"}]}],"30630":[{"footnoteId":11436,"paragraphs":[{"pid":49,"text":"Lit., “full of adulteress.”"}]},{"footnoteId":11437,"paragraphs":[{"pid":50,"text":"Lit., “baiting on.”"}]}],"30632":[{"footnoteId":11438,"paragraphs":[{"pid":51,"text":"Lit., “exceeding of law.”"}]}],"30635":[{"footnoteId":11439,"paragraphs":[{"pid":52,"text":"Or, “is overcome by something is enslaved by the same.”"}]}],"30636":[{"footnoteId":11440,"paragraphs":[{"pid":53,"text":"Lit., “having been inwoven.”"}]}],"30639":[{"footnoteId":11441,"paragraphs":[{"pid":54,"text":"Lit., “mental perception.”"}]}],"30641":[{"footnoteId":11442,"paragraphs":[{"pid":55,"text":"Lit., “players in sport [of mocking].”"}]}],"30642":[{"footnoteId":11443,"paragraphs":[{"pid":56,"text":"See App 5B."}]}],"30646":[{"footnoteId":11444,"paragraphs":[{"pid":57,"text":"See App 1D."}]}],"30647":[{"footnoteId":11445,"paragraphs":[{"pid":58,"text":"See App 1D."}]},{"footnoteId":11446,"paragraphs":[{"pid":59,"text":"Lit., “change of mind.” Gr., me·taʹnoi·an."}]}],"30648":[{"footnoteId":11447,"paragraphs":[{"pid":60,"text":"See App 1D."}]},{"footnoteId":11448,"paragraphs":[{"pid":61,"text":"Or, “the celestial bodies.” Gr., stoi·kheiʹa."}]},{"footnoteId":11449,"paragraphs":[{"pid":62,"text":"Lit., “will be loosed.”"}]},{"footnoteId":11450,"paragraphs":[{"pid":63,"text":"“Be discovered,” אB; AVgc, “be burned up.”"}]}],"30650":[{"footnoteId":11451,"paragraphs":[{"pid":64,"text":"“Keeping close in mind.” Or, “ardently desiring.” Lit., “speeding up.”"}]},{"footnoteId":11452,"paragraphs":[{"pid":65,"text":"See App 5B."}]},{"footnoteId":11453,"paragraphs":[{"pid":66,"text":"“Of Jehovah,” J7,8,17; CVgc(Gr.), tou Ky·riʹou; אABVgSyh, “of God.” See App 1D."}]}],"30653":[{"footnoteId":11454,"paragraphs":[{"pid":67,"text":"Lit., “longness of spirit.”"}]}],"30654":[{"footnoteId":11455,"paragraphs":[{"pid":68,"text":"Lit., “nonlearners.”"}]},{"footnoteId":11456,"paragraphs":[{"pid":69,"text":"Lit., “are distorting.”"}]}],"30655":[{"footnoteId":11457,"paragraphs":[{"pid":70,"text":"Lit., “illegal (ones).”"}]}]}