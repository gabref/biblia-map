{"30789":[{"footnoteId":11526,"paragraphs":[{"pid":13,"text":"Or, “Judas.” Gr., I·ouʹdas, meaning “Lauded.”"}]},{"footnoteId":11527,"paragraphs":[{"pid":14,"text":"Lit., “(ones) having been kept.”"}]}],"30791":[{"footnoteId":11528,"paragraphs":[{"pid":15,"text":"Lit., “encouraging.”"}]},{"footnoteId":11529,"paragraphs":[{"pid":16,"text":"Lit., “to be struggling upon.”"}]}],"30792":[{"footnoteId":11530,"paragraphs":[{"pid":17,"text":"Lit., “irreverential (ones).”"}]},{"footnoteId":11531,"paragraphs":[{"pid":18,"text":"Or, “for licentiousness (wantonness; shameless conduct).” Gr., eis a·selʹgei·an; J17,22(Heb.), lezim·mahʹ."}]}],"30793":[{"footnoteId":11532,"paragraphs":[{"pid":19,"text":"“Jehovah,” J7,8,11-14,16-18,22,23; א(Gr.), Kyʹri·os; Cc, “God”; ABVg, “Jesus.” See App 1D."}]}],"30796":[{"footnoteId":11533,"paragraphs":[{"pid":20,"text":"Lit., “they are blaspheming.”"}]},{"footnoteId":11534,"paragraphs":[{"pid":21,"text":"Lit., “of glories.”"}]}],"30797":[{"footnoteId":11535,"paragraphs":[{"pid":22,"text":"Lit., “having judged for self dividedly.”"}]},{"footnoteId":11536,"paragraphs":[{"pid":23,"text":"Lit., “he was saying in disagreement.”"}]},{"footnoteId":11537,"paragraphs":[{"pid":24,"text":"“Jehovah,” J7,8,11-14,16-18,22-24; AB(Gr.), Kyʹri·os; א*, “God.” See App 1D."}]}],"30802":[{"footnoteId":11538,"paragraphs":[{"pid":25,"text":"See App 1D."}]},{"footnoteId":11539,"paragraphs":[{"pid":26,"text":"Or, “holy tens of thousands.”"}]}],"30804":[{"footnoteId":11540,"paragraphs":[{"pid":27,"text":"Lit., “complainers at fate.”"}]},{"footnoteId":11541,"paragraphs":[{"pid":28,"text":"Lit., “wondering at faces.”"}]}],"30806":[{"footnoteId":11542,"paragraphs":[{"pid":29,"text":"Lit., “players in sport [of mocking].”"}]}],"30807":[{"footnoteId":11543,"paragraphs":[{"pid":30,"text":"Or, “distinctions.”"}]},{"footnoteId":11544,"paragraphs":[{"pid":31,"text":"Lit., “soulical ones; physical ones.” Gr., psy·khi·koiʹ; Lat., a·ni·maʹles; J17(Heb.), naph·shi·yimʹ."}]},{"footnoteId":11545,"paragraphs":[{"pid":32,"text":"Lit., “spirit.” Gr., pneuʹma; Lat., spiʹri·tum; J17,18,22(Heb.), weruʹach, “and spirit.”"}]}],"30812":[{"footnoteId":11546,"paragraphs":[{"pid":33,"text":"Lit., “not tripping.”"}]},{"footnoteId":11547,"paragraphs":[{"pid":34,"text":"Or, “unblemished before his glorious person.”"}]}],"30813":[{"footnoteId":11548,"paragraphs":[{"pid":35,"text":"Lit., “to only God Savior of us.” Gr., moʹnoi The·oiʹ So·teʹri he·monʹ; Lat., soʹli Deʹo sal·va·toʹri noʹstro."}]},{"footnoteId":11549,"paragraphs":[{"pid":36,"text":"Or, “before all time.”"}]}]}