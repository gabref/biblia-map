{"30814":[{"footnoteId":11550,"paragraphs":[{"pid":153,"text":"Lit., “uncovering; disclosure.” Gr., A·po·kaʹly·psis; Lat., A·po·ca·lyʹpsis."}]},{"footnoteId":11551,"paragraphs":[{"pid":154,"text":"Lit., “in quickness.”"}]}],"30817":[{"footnoteId":11552,"paragraphs":[{"pid":155,"text":"Lit., “The Being; The Existing One.” Gr., ho on. See Ex 3:14 ftn."}]}],"30821":[{"footnoteId":11553,"paragraphs":[{"pid":156,"text":"Or, “the A and the Z.” Gr., τὸ Ἄλφα καὶ τὸ Ὦ (to Alʹpha kai to O[·meʹga]), the first and last letters of the Gr. alphabet; SyhJ22, “the Aleph and the Taw.”"}]},{"footnoteId":11554,"paragraphs":[{"pid":157,"text":"See App 1D."}]},{"footnoteId":11555,"paragraphs":[{"pid":158,"text":"“The Almighty.” Gr., ho Pan·to·kraʹtor; Lat., O·mniʹpo·tens; J18(Heb.), ʼEl Shad·daiʹ, “God Almighty”; J17,22(Heb.), ʼElo·hehʹ tseva·ʼohthʹ, “God of armies.” See Ru 1:20 ftn, “Almighty.”"}]}],"30822":[{"footnoteId":11556,"paragraphs":[{"pid":159,"text":"“Bearing witness.” Gr., mar·ty·riʹan; Lat., te·sti·moʹni·um."}]},{"footnoteId":11557,"paragraphs":[{"pid":160,"text":"Lit., “through the word of the God and the witness of Jesus.”"}]}],"30823":[{"footnoteId":11558,"paragraphs":[{"pid":161,"text":"“By inspiration.” Or, “In spirit.” Gr., en pneuʹma·ti; Lat., in spiʹri·tu."}]},{"footnoteId":11559,"paragraphs":[{"pid":162,"text":"Or, “I came to be under inspiration on the Lord’s day.”"}]}],"30830":[{"footnoteId":11560,"paragraphs":[{"pid":163,"text":"“First,” אVgSyh; A, “Firstborn.”"}]}],"30831":[{"footnoteId":11561,"paragraphs":[{"pid":164,"text":"“Hades,” אA; SyhJ7,8,13,16-18,22, “Sheol.” See App 4B."}]}],"30833":[{"footnoteId":11562,"paragraphs":[{"pid":165,"text":"Or, “are.”"}]}],"30839":[{"footnoteId":11563,"paragraphs":[{"pid":166,"text":"Or, “deeds of the Nicolaitans.”"}]}],"30840":[{"footnoteId":11564,"paragraphs":[{"pid":167,"text":"“Paradise,” אAVgSyhJ11-13,16; J17,18,22, “garden.”"}]}],"30843":[{"footnoteId":11565,"paragraphs":[{"pid":168,"text":"Or, “until death; even with the danger of death.”"}]}],"30848":[{"footnoteId":11566,"paragraphs":[{"pid":169,"text":"Or, “teaching of the Nicolaitans.” Gr., di·da·khenʹ Ni·ko·la·i·tonʹ; Lat., doc·triʹnam Ni·co·la·i·taʹrum."}]}],"30850":[{"footnoteId":11567,"paragraphs":[{"pid":170,"text":"Or, “the manna laid up.”"}]},{"footnoteId":11568,"paragraphs":[{"pid":171,"text":"Lit., “[voting] pebble.” Gr., pseʹphon. See Ac 26:10 ftn."}]}],"30852":[{"footnoteId":11569,"paragraphs":[{"pid":172,"text":"“Ministry.” Gr., di·a·ko·niʹan."}]}],"30856":[{"footnoteId":11570,"paragraphs":[{"pid":173,"text":"Or, “with death.”"}]},{"footnoteId":11571,"paragraphs":[{"pid":174,"text":"Or, “deepest emotions.” Lit., “kidneys.” Compare Jer (11:20; 17:10; 20:12)."}]}],"30859":[{"footnoteId":11572,"paragraphs":[{"pid":175,"text":"Or, “complete end.” Gr., teʹlous."}]}],"30860":[{"footnoteId":11573,"paragraphs":[{"pid":176,"text":"Lit., “with an iron rod, as the clay vessels are broken to pieces.”"}]}],"30866":[{"footnoteId":11574,"paragraphs":[{"pid":177,"text":"Or, “persons.”"}]}],"30872":[{"footnoteId":11575,"paragraphs":[{"pid":178,"text":"Or, “kept what I said about endurance.”"}]},{"footnoteId":11576,"paragraphs":[{"pid":179,"text":"Lit., “the hour of the temptation.”"}]}],"30874":[{"footnoteId":11577,"paragraphs":[{"pid":180,"text":"Or, “divine habitation (dwelling).” Gr., na·oiʹ, dative, sing.; Lat., temʹplo; J17,18,22(Heb.), beheh·khalʹ, “in the palace (temple) of.”"}]},{"footnoteId":11578,"paragraphs":[{"pid":181,"text":"“Jerusalem,” meaning “Possession [or, Foundation] of Twofold Peace.”"}]}],"30876":[{"footnoteId":11579,"paragraphs":[{"pid":182,"text":"“The Amen.” Gr., ho A·menʹ; Lat., Aʹmen; J17,18,22(Heb.), ha·ʼA·menʹ, “the So Be It.”"}]}],"30878":[{"footnoteId":11580,"paragraphs":[{"pid":183,"text":"“I am going to vomit,” AVgSyh; א, “keep [your mouth] still!”"}]}],"30885":[{"footnoteId":11581,"paragraphs":[{"pid":184,"text":"Lit., “Step up.”"}]}],"30887":[{"footnoteId":11582,"paragraphs":[{"pid":185,"text":"Or, “a sardius [or, sardian stone].”"}]}],"30888":[{"footnoteId":11583,"paragraphs":[{"pid":186,"text":"“Elders.” Gr., pre·sby·teʹrous."}]}],"30889":[{"footnoteId":11584,"paragraphs":[{"pid":187,"text":"Lit., “are.”"}]}],"30892":[{"footnoteId":11585,"paragraphs":[{"pid":188,"text":"Or, “within.”"}]},{"footnoteId":11586,"paragraphs":[{"pid":189,"text":"“Holy, holy, holy,” AVgSyh; א* reads “holy” eight times. See App 1J."}]},{"footnoteId":11587,"paragraphs":[{"pid":190,"text":"See App 1D."}]},{"footnoteId":11588,"paragraphs":[{"pid":191,"text":"See 1:8 ftn, “Almighty.”"}]}],"30894":[{"footnoteId":11589,"paragraphs":[{"pid":192,"text":"“Elders.” Gr., pre·sbyʹte·roi."}]}],"30895":[{"footnoteId":11590,"paragraphs":[{"pid":193,"text":"See App 1D."}]}],"30897":[{"footnoteId":11591,"paragraphs":[{"pid":194,"text":"Or, “great.”"}]}],"30901":[{"footnoteId":11592,"paragraphs":[{"pid":195,"text":"Or, “are.”"}]},{"footnoteId":11593,"paragraphs":[{"pid":196,"text":"“Seven,” אVgcSyh; AVg omit."}]},{"footnoteId":11594,"paragraphs":[{"pid":197,"text":"“That,” אVg, referring to the “seven spirits”; A, “and which,” referring to the “eyes.”"}]}],"30903":[{"footnoteId":11595,"paragraphs":[{"pid":198,"text":"“The [incense] means,” א and Minuscule ms 046; A, “the [bowls] mean.”"}]}],"30905":[{"footnoteId":11596,"paragraphs":[{"pid":199,"text":"“They are to rule as kings; they rule as kings,” ASyh and Minuscule ms 046; אVg, “they will rule as kings.”"}]},{"footnoteId":11597,"paragraphs":[{"pid":200,"text":"“Over.” Gr., e·piʹ, with the genitive, as in 9:11; 11:6."}]}],"30906":[{"footnoteId":11598,"paragraphs":[{"pid":201,"text":"Or, “ten thousand times tens of thousands.”"}]}],"30915":[{"footnoteId":11599,"paragraphs":[{"pid":202,"text":"Gr., Khoiʹnix. More than a liter but less than a dry qt."}]},{"footnoteId":11600,"paragraphs":[{"pid":203,"text":"A Roman silver coin that weighed 3.85 g (0.124 oz t) and equaled a day’s wage. See Mt 20:2."}]}],"30917":[{"footnoteId":11601,"paragraphs":[{"pid":204,"text":"“Hades,” אA; SyhJ7,8,11-14,16-18,22, “Sheol.” See App 4B."}]},{"footnoteId":11602,"paragraphs":[{"pid":205,"text":"Lit., “famine.”"}]},{"footnoteId":11603,"paragraphs":[{"pid":206,"text":"Or, “with death.”"}]}],"30918":[{"footnoteId":11604,"paragraphs":[{"pid":207,"text":"Or, “even.”"}]},{"footnoteId":11605,"paragraphs":[{"pid":208,"text":"“Witness work.” Lit., “witness.” Gr., mar·ty·riʹan; Lat., te·sti·moʹni·um."}]}],"30919":[{"footnoteId":11606,"paragraphs":[{"pid":209,"text":"“Sovereign Lord.” Gr., ho De·spoʹtes; J17,22(Heb.), ʼAdho·naiʹ. See App 1E."}]}],"30924":[{"footnoteId":11607,"paragraphs":[{"pid":210,"text":"Or, “the chiliarchs,” each in command of 1,000 soldiers."}]}],"30927":[{"footnoteId":11608,"paragraphs":[{"pid":211,"text":"Or, “quarters; extremities.”"}]}],"30929":[{"footnoteId":11609,"paragraphs":[{"pid":212,"text":"Lit., “You should not treat unrighteously.”"}]}],"30930":[{"footnoteId":11610,"paragraphs":[{"pid":213,"text":"Lit., “(ones) having been sealed.”"}]}],"30931":[{"footnoteId":11611,"paragraphs":[{"pid":214,"text":"“Gad.” א omits."}]}],"30933":[{"footnoteId":11612,"paragraphs":[{"pid":215,"text":"“Simeon.” א omits."}]}],"30935":[{"footnoteId":11613,"paragraphs":[{"pid":216,"text":"Gr., ethʹnous, “ethnic group”; Lat., genʹti·bus, “Gentiles”; J17,18(Heb.), hag·goh·yimʹ, “the nations (goyim).”"}]}],"30936":[{"footnoteId":11614,"paragraphs":[{"pid":217,"text":"Lit., “The salvation.” Gr., He so·te·riʹa; Lat., saʹlus; J17,18,22(Heb.), ha·yeshu·ʽahʹ."}]}],"30937":[{"footnoteId":11615,"paragraphs":[{"pid":218,"text":"Gr., pre·sby·teʹron."}]}],"30938":[{"footnoteId":11616,"paragraphs":[{"pid":219,"text":"“Amen.” C omits."}]}],"30941":[{"footnoteId":11617,"paragraphs":[{"pid":220,"text":"“They are rendering . . . sacred service.” Gr., la·treuʹou·sin; J22(Heb.), weʽoh·vedhimʹ, “and they are serving (worshiping).” Compare Ex 3:12 ftn."}]},{"footnoteId":11618,"paragraphs":[{"pid":221,"text":"Or, “divine habitation (dwelling).” Gr., 