r, “is dried out.”"}]}],"31059":[{"footnoteId":11689,"paragraphs":[{"pid":292,"text":"See vs 15 ftn, “Sanctuary.”"}]}],"31062":[{"footnoteId":11690,"paragraphs":[{"pid":293,"text":"About 296 km (184 English mi). A furlong corresponded with a stadium, and equaled one eighth of a Roman mile, 185 m (606.75 English ft)."}]}],"31064":[{"footnoteId":11691,"paragraphs":[{"pid":294,"text":"Or, “upon.”"}]}],"31065":[{"footnoteId":11692,"paragraphs":[{"pid":295,"text":"See App 1D."}]},{"footnoteId":11693,"paragraphs":[{"pid":296,"text":"“Eternity,” P47א*CVgSyh; A and Minuscule ms 046, “the nations.”"}]}],"31066":[{"footnoteId":11694,"paragraphs":[{"pid":297,"text":"See App 1D."}]}],"31067":[{"footnoteId":11695,"paragraphs":[{"pid":298,"text":"Or, “tabernacle of the testimony.”"}]}],"31068":[{"footnoteId":11696,"paragraphs":[{"pid":299,"text":"“Linen,” P47אVgcSyh; AC, “stone.”"}]}],"31075":[{"footnoteId":11697,"paragraphs":[{"pid":300,"text":"“You,” אACVgSyh; TR, “You, O Lord”; J7,8,13,14,16, “You, Jehovah.”"}]}],"31077":[{"footnoteId":11698,"paragraphs":[{"pid":301,"text":"See App 1D."}]}],"31078":[{"footnoteId":11699,"paragraphs":[{"pid":302,"text":"Lit., “to it.”"}]},{"footnoteId":11700,"paragraphs":[{"pid":303,"text":"Or, “mankind.”"}]}],"31083":[{"footnoteId":11701,"paragraphs":[{"pid":304,"text":"Or, “unclean spirits.”"}]},{"footnoteId":11702,"paragraphs":[{"pid":305,"text":"“False prophet.” Gr., pseu·do·pro·pheʹtou; Lat., pseu·do·pro·pheʹtae; J17,22(Heb.), neviʼʹ hash·sheʹqer."}]}],"31084":[{"footnoteId":11703,"paragraphs":[{"pid":306,"text":"Or, “in fact, spirits of.”"}]},{"footnoteId":11704,"paragraphs":[{"pid":307,"text":"Lit., “inhabited.” Gr., oi·kou·meʹnes, fem. sing., referring to the earth."}]}],"31085":[{"footnoteId":11705,"paragraphs":[{"pid":308,"text":"“I am,” אcAVgSyh; א*, “He is.”"}]}],"31086":[{"footnoteId":11706,"paragraphs":[{"pid":309,"text":"“Place,” אVgSyh; A, “river.”"}]},{"footnoteId":11707,"paragraphs":[{"pid":310,"text":"Or, “Armageddon.” Gr., Har Ma·ge·donʹ; Lat., Her·ma·geʹdon; J18,22(Heb.), Har Meghid·dohnʹ, “Mountain of Megiddo.”"}]}],"31089":[{"footnoteId":11708,"paragraphs":[{"pid":311,"text":"Gr., Ba·by·lonʹ; J17,22(Heb.), Ba·velʹ."}]}],"31091":[{"footnoteId":11709,"paragraphs":[{"pid":312,"text":"About 20.4 kg (45 lb)."}]},{"footnoteId":11710,"paragraphs":[{"pid":313,"text":"Or, “mankind.”"}]}],"31092":[{"footnoteId":11711,"paragraphs":[{"pid":314,"text":"Or, “fornicatrix; prostitute.” Gr., porʹnes. See App 5A."}]},{"footnoteId":11712,"paragraphs":[{"pid":315,"text":"Or, “great.”"}]}],"31093":[{"footnoteId":11713,"paragraphs":[{"pid":316,"text":"Gr., por·neiʹas. See App 5A."}]}],"31096":[{"footnoteId":11714,"paragraphs":[{"pid":317,"text":"Or, “a religious secret,” sacred to Babylon."}]},{"footnoteId":11715,"paragraphs":[{"pid":318,"text":"See 16:19 ftn."}]}],"31098":[{"footnoteId":11716,"paragraphs":[{"pid":319,"text":"Or, “religious secret.” Gr., my·steʹri·on."}]}],"31099":[{"footnoteId":11717,"paragraphs":[{"pid":320,"text":"Lit., “throwing down [of seed].” Gr., ka·ta·bo·lesʹ."}]}],"31100":[{"footnoteId":11718,"paragraphs":[{"pid":321,"text":"Or, “are.”"}]}],"31101":[{"footnoteId":11719,"paragraphs":[{"pid":322,"text":"Or, “And they mean.”"}]}],"31102":[{"footnoteId":11720,"paragraphs":[{"pid":323,"text":"Or, “but owes its existence to the seven.”"}]}],"31105":[{"footnoteId":11721,"paragraphs":[{"pid":324,"text":"Or, “over; among.”"}]},{"footnoteId":11722,"paragraphs":[{"pid":325,"text":"Or, “over; among.”"}]}],"31106":[{"footnoteId":11723,"paragraphs":[{"pid":326,"text":"Or, “masses.”"}]}],"31108":[{"footnoteId":11724,"paragraphs":[{"pid":327,"text":"Or, “to carry out one purpose and give.” Lit., “to do one opinion and to give.”"}]}],"31109":[{"footnoteId":11725,"paragraphs":[{"pid":328,"text":"Or, “is.”"}]}],"31111":[{"footnoteId":11726,"paragraphs":[{"pid":329,"text":"Gr., Ba·by·lonʹ; J17,18,22(Heb.), Ba·velʹ."}]},{"footnoteId":11727,"paragraphs":[{"pid":330,"text":"Or, “spirit.”"}]}],"31112":[{"footnoteId":11728,"paragraphs":[{"pid":331,"text":"Or, “For because of the passion-arousing wine of her fornication.” A omits “of the wine.”"}]}],"31117":[{"footnoteId":11729,"paragraphs":[{"pid":332,"text":"“Jehovah,” J7,8,13,14,16-18,22-24; אcCSyh(Gr.), Kyʹri·os; AVg omit. See App 1D."}]}],"31121":[{"footnoteId":11730,"paragraphs":[{"pid":333,"text":"Or, “thyine wood.”"}]}],"31122":[{"footnoteId":11731,"paragraphs":[{"pid":334,"text":"Or, “amomum,” an Indian spice plant."}]},{"footnoteId":11732,"paragraphs":[{"pid":335,"text":"Lit., “bodies.”"}]},{"footnoteId":11733,"paragraphs":[{"pid":336,"text":"Or, “slaves, even souls of men.”"}]}],"31123":[{"footnoteId":11734,"paragraphs":[{"pid":337,"text":"Lit., “fruit of your soul’s desire.”"}]}],"31131":[{"footnoteId":11735,"paragraphs":[{"pid":338,"text":"“Of any trade,” CVgSyh; אA omit."}]}],"31132":[{"footnoteId":11736,"paragraphs":[{"pid":339,"text":"“Spiritistic practice.” Or, “sorcery.” Lit., “druggery.” Gr., phar·ma·kiʹai, dative, sing."}]}],"31134":[{"footnoteId":11737,"paragraphs":[{"pid":340,"text":"Or, “Hallelujah.” Gr., Hal·le·lou·i·aʹ; J22(Heb.), ha·lelu·yahʹ. Compare Ps 104:35 ftn, “People.”"}]},{"footnoteId":11738,"paragraphs":[{"pid":341,"text":"“Our God,” אACVgSyh; TR and some cursive mss, “the Lord our God”; J7,8,13,14,16,17, “Jehovah our God.”"}]}],"31135":[{"footnoteId":11739,"paragraphs":[{"pid":342,"text":"“His judgments are true and righteous,” אAVg; J7,8, “Jehovah is righteous and his judgments are upright.”"}]},{"footnoteId":11740,"paragraphs":[{"pid":343,"text":"Or, “fornicatrix; prostitute.” Gr., porʹnen. See App 5A."}]},{"footnoteId":11741,"paragraphs":[{"pid":344,"text":"“He,” אAVgSyh; eight mss from Nos. 95-217, “the Lord”; J7,8, “Jehovah.”"}]}],"31136":[{"footnoteId":11742,"paragraphs":[{"pid":345,"text":"See vs 1 ftn, “People.”"}]}],"31137":[{"footnoteId":11743,"paragraphs":[{"pid":346,"text":"Gr., pre·sbyʹte·roi."}]},{"footnoteId":11744,"paragraphs":[{"pid":347,"text":"Or, “Amen! Hallelujah!” See vs 1 ftn, “People.”"}]}],"31139":[{"footnoteId":11745,"paragraphs":[{"pid":348,"text":"Or, “great.”"}]},{"footnoteId":11746,"paragraphs":[{"pid":349,"text":"See vs 1 ftn, “People.”"}]},{"footnoteId":11747,"paragraphs":[{"pid":350,"text":"See App 1D."}]},{"footnoteId":11748,"paragraphs":[{"pid":351,"text":"“Our.” A omits."}]}],"31142":[{"footnoteId":11749,"paragraphs":[{"pid":352,"text":"“Those invited.” Lit., “(ones) having been called.”"}]},{"footnoteId":11750,"paragraphs":[{"pid":353,"text":"“Evening meal of the Lamb’s marriage,” AVgSyh; א, “evening meal of the Lamb.”"}]}],"31143":[{"footnoteId":11751,"paragraphs":[{"pid":354,"text":"“Bearing witness.” Gr., mar·ty·riʹa; Lat., te·sti·moʹni·um."}]},{"footnoteId":11752,"paragraphs":[{"pid":355,"text":"Or, “is the spirit of.”"}]},{"footnoteId":11753,"paragraphs":[{"pid":356,"text":"Or, “the prophecy.”"}]}],"31144":[{"footnoteId":11754,"paragraphs":[{"pid":357,"text":"“Called.” A omits."}]}],"31149":[{"footnoteId":11755,"paragraphs":[{"pid":358,"text":"Or, “over; among.”"}]}],"31151":[{"footnoteId":11756,"paragraphs":[{"pid":359,"text":"Or, “chiliarchs”; each a commander of 1,000 soldiers."}]}],"31158":[{"footnoteId":11757,"paragraphs":[{"pid":360,"text":"Lit., “through the witness of Jesus and through the word of the God.”"}]},{"footnoteId":11758,"paragraphs":[{"pid":361,"text":"“Thousand years.” Gr., khiʹli·a eʹte, root for the English word “chiliasts,” believers in a literal thousand-year reign of Christ over mankind on a paradise earth; Lat., milʹle anʹnis, “a millennium.”"}]}],"31159":[{"footnoteId":11759,"paragraphs":[{"pid":362,"text":"“The rest of the dead . . . were ended,” AVg; אSyp omit."}]},{"footnoteId":11760,"paragraphs":[{"pid":363,"text":"“Resurrection.” Gr., a·naʹsta·sis, “raising up; standing up” (from a·naʹ, “up,” and staʹsis, “standing”); Lat., re·sur·recʹti·o."}]}],"31162":[{"footnoteId":11761,"paragraphs":[{"pid":364,"text":"Or, “quarters; extremities.” Compare 7:1."}]}],"31163":[{"footnoteId":11762,"paragraphs":[{"pid":365,"text":"Or, “the army in battle line.” Lit., “encampment.”"}]}],"31164":[{"footnoteId":11763,"paragraphs":[{"pid":366,"text":"Lit., “making to err.”"}]}],"31165":[{"footnoteId":11764,"paragraphs":[{"pid":367,"text":"Or, “From the face of him.”"}]}],"31166":[{"footnoteId":11765,"paragraphs":[{"pid":368,"text":"Lit., “little books.” Gr., bi·bliʹa."}]}],"31167":[{"footnoteId":11766,"paragraphs":[{"pid":369,"text":"“Hades.” Gr., haiʹdes; Vg(Lat.), inʹfe·rus; Vgc(Lat.), in·ferʹnus; SyhJ7,8,11-14,16-18,22, “Sheol.” See App 4B."}]}],"31168":[{"footnoteId":11767,"paragraphs":[{"pid":370,"text":"See App 4C."}]},{"footnoteId":11768,"paragraphs":[{"pid":371,"text":"Or, “is.”"}]}],"31172":[{"footnoteId":11769,"paragraphs":[{"pid":372,"text":"“Tent.” Gr., ske·neʹ; Lat., ta·ber·naʹcu·lum; J17,18,22(Heb.), mish·kanʹ. See Ex 25:8."}]},{"footnoteId":11770,"paragraphs":[{"pid":373,"text":"Lit., “he will tent.”"}]}],"31175":[{"footnoteId":11771,"paragraphs":[{"pid":374,"text":"Or, “They are a fact!”"}]},{"footnoteId":11772,"paragraphs":[{"pid":375,"text":"Or, “I am the A and the Z.” Compare 1:8 ftn, “Omega.”"}]}],"31177":[{"footnoteId":11773,"paragraphs":[{"pid":376,"text":"“Those practicing spiritism.” Or, “sorcerers.” Lit., “druggers.” Gr., phar·ma·koisʹ."}]},{"footnoteId":11774,"paragraphs":[{"pid":377,"text":"Or, “This portion is.”"}]}],"31180":[{"footnoteId":11775,"paragraphs":[{"pid":378,"text":"Or, “illuminator.”"}]}],"31185":[{"footnoteId":11776,"paragraphs":[{"pid":379,"text":"About 2,220 km (1,379 English mi). A furlong corresponded to a stadium and equaled one eighth of a Roman mile, 185 m (606.75 ft)."}]}],"31186":[{"footnoteId":11777,"paragraphs":[{"pid":380,"text":"About 64 m (210 ft)."}]},{"footnoteId":11778,"paragraphs":[{"pid":381,"text":"Or, “that is, an angel’s.”"}]}],"31191":[{"footnoteId":11779,"paragraphs":[{"pid":382,"text":"Or, “divine habitation (dwelling).” Gr., na·onʹ; Lat., temʹplum; J17,18(Heb.), weheh·khalʹ, “and a palace (temple).”"}]},{"footnoteId":11780,"paragraphs":[{"pid":383,"text":"See App 1D."}]},{"footnoteId":11781,"paragraphs":[{"pid":384,"text":"“Almighty.” Gr., Pan·to·kraʹtor; Lat., O·mniʹpo·tens; J17,22(Heb.), ʼElo·himʹ tseva·ʼohthʹ, “God of armies.” See Ru 1:20 ftn, “Almighty.”"}]}],"31198":[{"footnoteId":11782,"paragraphs":[{"pid":385,"text":"Lit., “tree” (generically); or, “wood.” Gr., xyʹlon."}]}],"31199":[{"footnoteId":11783,"paragraphs":[{"pid":386,"text":"Or, “it,” fem., that is, the city."}]},{"footnoteId":11784,"paragraphs":[{"pid":387,"text":"“Will render . . . sacred service.” Gr., la·treuʹsou·sin. See Ex 3:12 ftn."}]}],"31201":[{"footnoteId":11785,"paragraphs":[{"pid":388,"text":"See App 1D."}]}],"31202":[{"footnoteId":11786,"paragraphs":[{"pid":389,"text":"See App 1D."}]},{"footnoteId":11787,"paragraphs":[{"pid":390,"text":"Or, “of the spirits.” Gr., ton pneu·maʹton; Lat., spi·riʹtu·um."}]}],"31206":[{"footnoteId":11788,"paragraphs":[{"pid":391,"text":"Or, “Do not keep secret.”"}]}],"31209":[{"footnoteId":11789,"paragraphs":[{"pid":392,"text":"Or, “I am the A and the Z.” See 1:8 ftn, “Omega” and ad under “Alpha and Omega.”"}]}],"31210":[{"footnoteId":11790,"paragraphs":[{"pid":393,"text":"See vs 2 ftn."}]}],"31211":[{"footnoteId":11791,"paragraphs":[{"pid":394,"text":"“Those who practice spiritism.” Or, “sorcerers.” Lit., “druggers.” Gr., phar·ma·koiʹ."}]}],"31213":[{"footnoteId":11792,"paragraphs":[{"pid":395,"text":"Or, “the inspired utterance.”"}]}],"31217":[{"footnoteId":11793,"paragraphs":[{"pid":396,"text":"“Christ,” VgSyh; אA omit."}]},{"footnoteId":11794,"paragraphs":[{"pid":397,"text":"“With the holy ones. Amen!” א; Syh, “with all the holy ones. Amen!”; Vgc, “with you all. Amen!”; AVg, “with all.”"}]}]}