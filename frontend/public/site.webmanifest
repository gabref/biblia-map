{
   "name": "BibliaMap — Bible cross-reference map",
   "short_name": "BibliaMap",
   "description": "Explore the Bible’s cross-references as an interactive map — books, chapters and study notes.",
   "start_url": "/",
   "scope": "/",
   "display": "standalone",
   "background_color": "#0d1015",
   "theme_color": "#0d1015",
   "share_target": {
      "action": "/open",
      "method": "GET",
      "params": { "title": "title", "text": "text", "url": "url" }
   },
   "icons": [
      {
         "src": "/bibliamap-icon.svg",
         "sizes": "any",
         "type": "image/svg+xml",
         "purpose": "any"
      },
      {
         "src": "/bibliamap-icon-192.png",
         "sizes": "192x192",
         "type": "image/png",
         "purpose": "any"
      },
      {
         "src": "/bibliamap-icon-512.png",
         "sizes": "512x512",
         "type": "image/png",
         "purpose": "any"
      },
      {
         "src": "/bibliamap-icon-maskable-512.png",
         "sizes": "512x512",
         "type": "image/png",
         "purpose": "maskable"
      }
   ]
}
